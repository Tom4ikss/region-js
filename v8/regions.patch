@@ -0,0 +1,708 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "src/d8/d8-port.h"
+
+#include <algorithm>
+#include <atomic>
+#include <deque>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "include/v8-container.h"
+#include "include/v8-context.h"
+#include "include/v8-exception.h"
+#include "include/v8-external.h"
+#include "include/v8-function.h"
+#include "include/v8-isolate.h"
+#include "include/v8-microtask-queue.h"
+#include "include/v8-object.h"
+#include "include/v8-persistent-handle.h"
+#include "include/v8-platform.h"
+#include "include/v8-primitive.h"
+#include "src/api/api-inl.h"
+#include "src/base/lazy-instance.h"
+#include "src/base/macros.h"
+#include "src/base/platform/mutex.h"
+#include "src/base/platform/semaphore.h"
+#include "src/base/platform/time.h"
+#include "src/d8/d8-channel.h"
+#include "src/d8/d8.h"
+#include "src/execution/isolate.h"
+#include "src/handles/shared-object-conveyor-handles.h"
+#include "src/heap/parked-scope-inl.h"
+#include "src/init/v8.h"
+#include "src/objects/js-region-inl.h"
+
+namespace v8 {
+
+// Client -> server: tasks. Server -> client: replies.
+struct PortState {
+  base::Mutex mutex;
+  // Guarded by `mutex`.
+  std::deque<std::unique_ptr<PortMessage>> inbox;
+  Isolate* server = nullptr;
+  std::shared_ptr<TaskRunner> server_runner;
+  bool server_drain_scheduled = false;
+  std::deque<std::unique_ptr<PortMessage>> outbox;
+  Isolate* client = nullptr;
+  std::shared_ptr<TaskRunner> client_runner;
+  bool listening = false;
+  bool client_drain_scheduled = false;
+  bool gone_reported = false;
+  // Tasks sent whose reply the client has not taken yet.
+  int expected = 0;
+
+  // Read without the mutex by a client that spins waiting for a reply.
+  std::atomic<size_t> outbox_size{0};
+  std::atomic<bool> server_gone{false};
+  // Signalled for every reply and when the server goes away.
+  base::Semaphore reply_signal{0};
+};
+
+namespace {
+
+constexpr ExternalPointerTypeTag kPortTag = kExternalPointerTypeTagDefault;
+
+struct PortHandle {
+  std::shared_ptr<PortState> state;
+  Global<Object> object;
+};
+
+struct Handler {
+  std::shared_ptr<PortState> state;
+  Global<Function> function;
+  Global<Context> context;
+};
+
+struct IsolatePorts {
+  Global<FunctionTemplate> ctor;
+  std::unordered_set<PortHandle*> handles;
+  // Ports this isolate serves, and ports it listens on as a client.
+  std::unordered_map<PortState*, Handler> serving;
+  std::unordered_map<PortState*, Handler> listening;
+  // Ports created here, i.e. where this isolate is the client.
+  std::vector<std::shared_ptr<PortState>> clients;
+};
+
+base::LazyMutex isolates_mutex = LAZY_MUTEX_INITIALIZER;
+
+std::unordered_map<Isolate*, IsolatePorts>& AllData() {
+  static base::LeakyObject<std::unordered_map<Isolate*, IsolatePorts>> all;
+  return *all.get();
+}
+
+// Elements of an unordered_map keep their address; only the isolate's own
+// thread uses its entry.
+IsolatePorts& DataOf(Isolate* isolate) {
+  base::MutexGuard guard(isolates_mutex.Pointer());
+  return AllData()[isolate];
+}
+
+void ThrowTypeError(Isolate* isolate, const char* message) {
+  isolate->ThrowException(Exception::TypeError(
+      String::NewFromUtf8(isolate, message).ToLocalChecked()));
+}
+
+// The region a transfer list entry stands for: a Region handle or a region
+// object. -1 otherwise.
+int TransferredRegion(Isolate* isolate, Local<Value> value) {
+  Local<FunctionTemplate> region_ctor =
+      PerIsolateData::Get(isolate)->GetRegionCtor();
+  if (!region_ctor.IsEmpty() && region_ctor->HasInstance(value)) {
+    return value.As<Object>()->GetInternalField(0).As<Int32>()->Value();
+  }
+  i::Tagged<i::Object> raw = *Utils::OpenDirectHandle(*value);
+  if (i::IsJSRegionObject(raw)) {
+    return i::Cast<i::JSRegionObject>(raw)->region_id();
+  }
+  return -1;
+}
+
+// Appends `element` to the message. Returns false, without throwing, if it
+// is not a primitive, string, region object or channel.
+bool AppendSlot(Isolate* isolate, PortMessage* message, Local<Value> element) {
+  using Kind = PortMessage::Kind;
+  if (element->IsUndefined()) {
+    message->slots.push_back({Kind::kUndefined, 0, 0});
+  } else if (element->IsNull()) {
+    message->slots.push_back({Kind::kNull, 0, 0});
+  } else if (element->IsTrue()) {
+    message->slots.push_back({Kind::kTrue, 0, 0});
+  } else if (element->IsFalse()) {
+    message->slots.push_back({Kind::kFalse, 0, 0});
+  } else if (element->IsNumber()) {
+    message->slots.push_back({Kind::kNumber, element.As<Number>()->Value(), 0});
+  } else if (element->IsString()) {
+    Local<String> string = element.As<String>();
+    std::u16string copy(string->Length(), u'\0');
+    string->Write(isolate, 0, string->Length(),
+                  reinterpret_cast<uint16_t*>(copy.data()));
+    message->slots.push_back(
+        {Kind::kString, 0, static_cast<uint32_t>(message->strings.size())});
+    message->strings.push_back(std::move(copy));
+  } else if (i::Tagged<i::Object> raw = *Utils::OpenDirectHandle(*element);
+             i::IsJSRegionObject(raw)) {
+    if (!message->shared) {
+      message->shared = std::make_unique<i::SharedObjectConveyorHandles>(
+          reinterpret_cast<i::Isolate*>(isolate));
+    }
+    message->slots.push_back(
+        {Kind::kShared, 0,
+         message->shared->Persist(i::Cast<i::HeapObject>(raw))});
+  } else if (std::shared_ptr<ChannelState> channel =
+                 Channels::FromValue(isolate, element)) {
+    message->slots.push_back(
+        {Kind::kChannel, 0, static_cast<uint32_t>(message->channels.size())});
+    message->channels.push_back(std::move(channel));
+  } else {
+    return false;
+  }
+  return true;
+}
+
+// Moves the regions in `transfer` with the message. Checks every region
+// before moving any, so that a failure changes nothing.
+bool AddTransfer(Isolate* isolate, PortMessage* message, Local<Value> transfer) {
+  if (!transfer->IsArray()) return true;
+  Local<Context> context = isolate->GetCurrentContext();
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  std::vector<int> regions;
+  Local<Array> list = transfer.As<Array>();
+  for (uint32_t i = 0; i < list->Length(); i++) {
+    Local<Value> element;
+    if (!list->Get(context, i).ToLocal(&element)) return false;
+    int region = TransferredRegion(isolate, element);
+    if (region < 0) {
+      ThrowTypeError(isolate, "Transfer array elements must be regions");
+      return false;
+    }
+    if (!i::RegionRegistry::IsOwner(region, i_isolate) &&
+        !i::RegionRegistry::IsFrozenBy(region, i_isolate)) {
+      ThrowTypeError(isolate,
+                     i::RegionRegistry::IsFreed(region) ? "Region was freed"
+                     : i::RegionRegistry::IsFrozen(region)
+                         ? "Region was frozen by another isolate"
+                         : "Region is not owned by this isolate");
+      return false;
+    }
+    if (std::find(regions.begin(), regions.end(), region) == regions.end()) {
+      regions.push_back(region);
+    }
+  }
+  for (int region : regions) {
+    i::RegionRegistry::AddHandle(region);
+    bool frozen = i::RegionRegistry::IsFrozen(region);
+    if (frozen) {
+      CHECK(i::RegionRegistry::ReleaseFreeze(region, i_isolate));
+      i::JSRegionObject::DetachFrozenViewsIfUnused(i_isolate, region);
+    } else {
+      i::JSRegionObject::DetachViews(i_isolate, region);
+      CHECK(i::RegionRegistry::Release(region, i_isolate));
+    }
+    message->regions.push_back(
+        {region, i::RegionRegistry::Generation(region), false, frozen});
+  }
+  return true;
+}
+
+std::unique_ptr<PortMessage> Marshal(Isolate* isolate, Local<Value> value,
+                                     Local<Value> transfer) {
+  Local<Context> context = isolate->GetCurrentContext();
+  if (!value->IsArray()) {
+    ThrowTypeError(isolate, "a task port message must be an array");
+    return nullptr;
+  }
+  Local<Array> array = value.As<Array>();
+  auto message = std::make_unique<PortMessage>();
+  uint32_t length = array->Length();
+  message->slots.reserve(length);
+  for (uint32_t i = 0; i < length; i++) {
+    Local<Value> element;
+    if (!array->Get(context, i).ToLocal(&element)) return nullptr;
+    if (!AppendSlot(isolate, message.get(), element)) {
+      ThrowTypeError(isolate,
+                     "a task port message can only hold primitives, strings, "
+                     "region objects and channels");
+      return nullptr;
+    }
+  }
+  if (!AddTransfer(isolate, message.get(), transfer)) return nullptr;
+  return message;
+}
+
+MaybeLocal<Array> Unmarshal(Isolate* isolate, PortMessage* message) {
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  for (SerializationData::MovedRegion& moved : message->regions) {
+    bool claimed =
+        moved.frozen
+            ? i::RegionRegistry::ClaimFreeze(moved.id, moved.generation,
+                                             i_isolate)
+            : i::RegionRegistry::Claim(moved.id, moved.generation, i_isolate);
+    if (!claimed) {
+      ThrowTypeError(isolate, "Region is not in transit");
+      return {};
+    }
+    moved.claimed = true;
+    i::RegionRegistry::RemoveHandle(moved.id);
+  }
+  std::vector<Local<Value>> elements;
+  elements.reserve(message->slots.size());
+  using Kind = PortMessage::Kind;
+  for (const PortMessage::Slot& slot : message->slots) {
+    switch (slot.kind) {
+      case Kind::kUndefined:
+        elements.push_back(Undefined(isolate));
+        break;
+      case Kind::kNull:
+        elements.push_back(Null(isolate));
+        break;
+      case Kind::kTrue:
+        elements.push_back(True(isolate));
+        break;
+      case Kind::kFalse:
+        elements.push_back(False(isolate));
+        break;
+      case Kind::kNumber:
+        elements.push_back(Number::New(isolate, slot.number));
+        break;
+      case Kind::kString: {
+        const std::u16string& string = message->strings[slot.index];
+        Local<String> value;
+        if (!String::NewFromTwoByte(
+                 isolate, reinterpret_cast<const uint16_t*>(string.data()),
+                 NewStringType::kNormal, static_cast<int>(string.size()))
+                 .ToLocal(&value)) {
+          return {};
+        }
+        elements.push_back(value);
+        break;
+      }
+      case Kind::kShared:
+        elements.push_back(Utils::ToLocal(i::direct_handle(
+            message->shared->GetPersisted(slot.index), i_isolate)));
+        break;
+      case Kind::kChannel: {
+        Local<Object> channel;
+        if (!Channels::ToObject(isolate, message->channels[slot.index])
+                 .ToLocal(&channel)) {
+          return {};
+        }
+        elements.push_back(channel);
+        break;
+      }
+    }
+  }
+  return Array::New(isolate, elements.data(), elements.size());
+}
+
+// Delivers queued messages to the handler of an isolate: tasks to a server,
+// replies to a listening client. One task drains everything queued.
+class DrainTask : public Task {
+ public:
+  DrainTask(Isolate* isolate, std::shared_ptr<PortState> state, bool server)
+      : isolate_(isolate), state_(std::move(state)), server_(server) {}
+
+  void Run() override {
+    IsolatePorts& data = DataOf(isolate_);
+    for (;;) {
+      if (isolate_->IsExecutionTerminating()) return;
+      std::unique_ptr<PortMessage> message;
+      bool report_gone = false;
+      {
+        base::MutexGuard guard(&state_->mutex);
+        if (server_) {
+          if (state_->inbox.empty()) {
+            state_->server_drain_scheduled = false;
+            return;
+          }
+          message = std::move(state_->inbox.front());
+          state_->inbox.pop_front();
+        } else {
+          if (!state_->listening || state_->outbox.empty()) {
+            report_gone = state_->listening && state_->server_gone &&
+                          !state_->gone_reported;
+            if (report_gone) state_->gone_reported = true;
+            state_->client_drain_scheduled = false;
+            if (!report_gone) return;
+          } else {
+            message = std::move(state_->outbox.front());
+            state_->outbox.pop_front();
+            state_->outbox_size.fetch_sub(1, std::memory_order_release);
+            state_->expected--;
+          }
+        }
+      }
+      auto& handlers = server_ ? data.serving : data.listening;
+      auto it = handlers.find(state_.get());
+      if (it == handlers.end()) return;
+      HandleScope scope(isolate_);
+      Local<Context> context = it->second.context.Get(isolate_);
+      Local<Function> function = it->second.function.Get(isolate_);
+      Context::Scope context_scope(context);
+      TryCatch try_catch(isolate_);
+      try_catch.SetVerbose(true);
+      Local<Value> argument = Undefined(isolate_);
+      if (message) {
+        Local<Array> array;
+        if (!Unmarshal(isolate_, message.get()).ToLocal(&array)) continue;
+        argument = array;
+      }
+      USE(function->Call(context, Undefined(isolate_), 1, &argument));
+      // Like separate messages: promise jobs of one run before the next.
+      MicrotasksScope::PerformCheckpoint(isolate_);
+      if (report_gone) return;
+    }
+  }
+
+ private:
+  Isolate* const isolate_;
+  const std::shared_ptr<PortState> state_;
+  const bool server_;
+};
+
+std::shared_ptr<PortState> ThisState(const FunctionCallbackInfo<Value>& info) {
+  std::shared_ptr<PortState> state = Ports::FromValue(info.GetIsolate(), info.This());
+  if (!state) ThrowTypeError(info.GetIsolate(), "this is not a task port");
+  return state;
+}
+
+void Attach(Isolate* isolate, Local<Object> object,
+            std::shared_ptr<PortState> state) {
+  auto* handle = new PortHandle{std::move(state), Global<Object>()};
+  handle->object.Reset(isolate, object);
+  handle->object.SetWeak(
+      handle,
+      [](const WeakCallbackInfo<PortHandle>& info) {
+        PortHandle* handle = info.GetParameter();
+        DataOf(info.GetIsolate()).handles.erase(handle);
+        handle->object.Reset();
+        delete handle;
+      },
+      WeakCallbackType::kParameter);
+  object->SetInternalField(0, External::New(isolate, handle, kPortTag));
+  DataOf(isolate).handles.insert(handle);
+}
+
+Handler MakeHandler(Isolate* isolate, std::shared_ptr<PortState> state,
+                    Local<Function> function) {
+  Handler handler{std::move(state), Global<Function>(isolate, function),
+                  Global<Context>(isolate, isolate->GetCurrentContext())};
+  return handler;
+}
+
+// Region.__port(): a port whose client is the calling isolate.
+void PortNew(const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  IsolatePorts& data = DataOf(isolate);
+  Local<Object> object;
+  if (data.ctor.IsEmpty() ||
+      !data.ctor.Get(isolate)
+           ->InstanceTemplate()
+           ->NewInstance(isolate->GetCurrentContext())
+           .ToLocal(&object)) {
+    return;
+  }
+  auto state = std::make_shared<PortState>();
+  state->client = isolate;
+  state->client_runner =
+      i::V8::GetCurrentPlatform()->GetForegroundTaskRunner(isolate);
+  data.clients.push_back(state);
+  Attach(isolate, object, std::move(state));
+  info.GetReturnValue().Set(object);
+}
+
+// port.serve(handler): this isolate runs the tasks sent to the port.
+void PortServe(const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  std::shared_ptr<PortState> state = ThisState(info);
+  if (!state) return;
+  if (!info[0]->IsFunction()) {
+    ThrowTypeError(isolate, "port.serve() expects a function");
+    return;
+  }
+  std::shared_ptr<TaskRunner> runner;
+  {
+    base::MutexGuard guard(&state->mutex);
+    if (state->server) {
+      ThrowTypeError(isolate, "the port is already served");
+      return;
+    }
+    state->server = isolate;
+    state->server_runner =
+        i::V8::GetCurrentPlatform()->GetForegroundTaskRunner(isolate);
+    if (!state->inbox.empty()) {
+      state->server_drain_scheduled = true;
+      runner = state->server_runner;
+    }
+  }
+  DataOf(isolate).serving.insert_or_assign(
+      state.get(), MakeHandler(isolate, state, info[0].As<Function>()));
+  if (runner) runner->PostTask(std::make_unique<DrainTask>(isolate, state, true));
+}
+
+// port.send(message, transfer): client -> server.
+void PortSend(const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  std::shared_ptr<PortState> state = ThisState(info);
+  if (!state) return;
+  if (state->server_gone.load(std::memory_order_acquire)) {
+    ThrowTypeError(isolate, "spawn() worker is gone");
+    return;
+  }
+  std::unique_ptr<PortMessage> message = Marshal(isolate, info[0], info[1]);
+  if (!message) return;
+  std::shared_ptr<TaskRunner> runner;
+  Isolate* server;
+  {
+    base::MutexGuard guard(&state->mutex);
+    state->inbox.push_back(std::move(message));
+    state->expected++;
+    if (state->server_runner && !state->server_drain_scheduled) {
+      state->server_drain_scheduled = true;
+      runner = state->server_runner;
+      server = state->server;
+    }
+  }
+  if (runner) runner->PostTask(std::make_unique<DrainTask>(server, state, true));
+}
+
+// port.reply(message, transfer): server -> client.
+void PortReply(const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  std::shared_ptr<PortState> state = ThisState(info);
+  if (!state) return;
+  std::unique_ptr<PortMessage> message = Marshal(isolate, info[0], info[1]);
+  if (!message) return;
+  std::shared_ptr<TaskRunner> runner;
+  Isolate* client;
+  {
+    base::MutexGuard guard(&state->mutex);
+    if (!state->client_runner) return;  // The client is gone.
+    state->outbox.push_back(std::move(message));
+    state->outbox_size.fetch_add(1, std::memory_order_release);
+    if (state->listening && !state->client_drain_scheduled) {
+      state->client_drain_scheduled = true;
+      runner = state->client_runner;
+      client = state->client;
+    }
+  }
+  state->reply_signal.Signal();
+  if (runner) runner->PostTask(std::make_unique<DrainTask>(client, state, false));
+}
+
+// port.take(): blocks until a reply arrives; undefined once the server is
+// gone and every reply was taken.
+void PortTake(const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  std::shared_ptr<PortState> state = ThisState(info);
+  if (!state) return;
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  for (;;) {
+    std::unique_ptr<PortMessage> message;
+    {
+      base::MutexGuard guard(&state->mutex);
+      if (!state->outbox.empty()) {
+        message = std::move(state->outbox.front());
+        state->outbox.pop_front();
+        state->outbox_size.fetch_sub(1, std::memory_order_release);
+        state->expected--;
+      } else if (state->server_gone.load(std::memory_order_acquire)) {
+        return;
+      }
+    }
+    if (message) {
+      Local<Array> array;
+      if (Unmarshal(isolate, message.get()).ToLocal(&array)) {
+        info.GetReturnValue().Set(array);
+      }
+      return;
+    }
+    if (Shell::SpinUntil([&] {
+          return state->outbox_size.load(std::memory_order_acquire) > 0 ||
+                 state->server_gone.load(std::memory_order_acquire);
+        })) {
+      continue;
+    }
+    bool terminated = false;
+    i_isolate->main_thread_local_isolate()->ExecuteMainThreadWhileParked(
+        [&](const i::ParkedScope&) {
+          while (!state->reply_signal.WaitFor(
+              base::TimeDelta::FromMilliseconds(50))) {
+            if (i_isolate->stack_guard()->HasTerminationRequest() ||
+                i_isolate->is_execution_terminating()) {
+              terminated = true;
+              return;
+            }
+          }
+        });
+    if (terminated) {
+      isolate->TerminateExecution();
+      return;
+    }
+  }
+}
+
+// port.listen(handler | null): replies go to `handler` from the event loop.
+// While listening with replies due, the event loop keeps running.
+void PortListen(const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  std::shared_ptr<PortState> state = ThisState(info);
+  if (!state) return;
+  IsolatePorts& data = DataOf(isolate);
+  bool listen = info[0]->IsFunction();
+  if (listen) {
+    data.listening.insert_or_assign(
+        state.get(), MakeHandler(isolate, state, info[0].As<Function>()));
+  } else {
+    data.listening.erase(state.get());
+  }
+  std::shared_ptr<TaskRunner> runner;
+  {
+    base::MutexGuard guard(&state->mutex);
+    state->listening = listen;
+    bool due = !state->outbox.empty() ||
+               (state->server_gone && !state->gone_reported);
+    if (listen && due && !state->client_drain_scheduled) {
+      state->client_drain_scheduled = true;
+      runner = state->client_runner;
+    }
+  }
+  if (runner) runner->PostTask(std::make_unique<DrainTask>(isolate, state, false));
+}
+
+}  // namespace
+
+// static
+Local<FunctionTemplate> Ports::CreateTemplate(Isolate* isolate) {
+  Local<FunctionTemplate> ctor = FunctionTemplate::New(isolate);
+  ctor->SetClassName(String::NewFromUtf8Literal(isolate, "TaskPort"));
+  ctor->InstanceTemplate()->SetInternalFieldCount(1);
+  Local<Signature> signature = Signature::New(isolate, ctor);
+  for (auto [name, callback] :
+       {std::pair{"serve", PortServe}, std::pair{"send", PortSend},
+        std::pair{"reply", PortReply}, std::pair{"take", PortTake},
+        std::pair{"listen", PortListen}}) {
+    ctor->PrototypeTemplate()->Set(
+        String::NewFromUtf8(isolate, name).ToLocalChecked(),
+        FunctionTemplate::New(isolate, callback, Local<Value>(), signature, 0,
+                              ConstructorBehavior::kThrow));
+  }
+  DataOf(isolate).ctor.Reset(isolate, ctor);
+  // Region.__port() creates ports; the template itself is not exposed.
+  return FunctionTemplate::New(isolate, PortNew);
+}
+
+// static
+std::shared_ptr<PortState> Ports::FromValue(Isolate* isolate,
+                                            Local<Value> value) {
+  IsolatePorts& data = DataOf(isolate);
+  if (data.ctor.IsEmpty() || !value->IsObject()) return nullptr;
+  if (!data.ctor.Get(isolate)->HasInstance(value)) return nullptr;
+  Local<Data> field = value.As<Object>()->GetInternalField(0);
+  if (!field->IsValue() || !field.As<Value>()->IsExternal()) return nullptr;
+  return static_cast<PortHandle*>(
+             field.As<Value>().As<External>()->Value(kPortTag))
+      ->state;
+}
+
+// static
+MaybeLocal<Object> Ports::ToObject(Isolate* isolate,
+                                   std::shared_ptr<PortState> state) {
+  IsolatePorts& data = DataOf(isolate);
+  if (data.ctor.IsEmpty()) return {};
+  Local<Object> object;
+  if (!data.ctor.Get(isolate)
+           ->InstanceTemplate()
+           ->NewInstance(isolate->GetCurrentContext())
+           .ToLocal(&object)) {
+    return {};
+  }
+  Attach(isolate, object, std::move(state));
+  return object;
+}
+
+// static
+std::unique_ptr<PortMessage> Ports::MarshalValue(Isolate* isolate,
+                                                 Local<Value> value,
+                                                 Local<Value> transfer,
+                                                 bool* native) {
+  auto message = std::make_unique<PortMessage>();
+  *native = AppendSlot(isolate, message.get(), value);
+  if (!*native) return nullptr;
+  if (!AddTransfer(isolate, message.get(), transfer)) return nullptr;
+  return message;
+}
+
+// static
+MaybeLocal<Value> Ports::UnmarshalValue(Isolate* isolate,
+                                        PortMessage* message) {
+  Local<Array> array;
+  if (!Unmarshal(isolate, message).ToLocal(&array)) return {};
+  return array->Get(isolate->GetCurrentContext(), 0);
+}
+
+// static
+bool Ports::HasPendingWork(Isolate* isolate) {
+  IsolatePorts& data = DataOf(isolate);
+  for (auto& [raw, handler] : data.listening) {
+    base::MutexGuard guard(&raw->mutex);
+    if (raw->expected > 0 && !raw->server_gone) return true;
+    if (raw->server_gone && !raw->gone_reported) return true;
+  }
+  return false;
+}
+
+// static
+void Ports::ForgetIsolate(Isolate* isolate) {
+  IsolatePorts& data = DataOf(isolate);
+  // Tasks for a dead server are dropped; its client hears that it is gone.
+  for (auto& [raw, handler] : data.serving) {
+    std::shared_ptr<PortState> state = handler.state;
+    std::shared_ptr<TaskRunner> runner;
+    Isolate* client;
+    {
+      base::MutexGuard guard(&state->mutex);
+      state->server_gone.store(true, std::memory_order_release);
+      state->server_runner.reset();
+      state->inbox.clear();
+      if (state->listening && state->client_runner &&
+          !state->client_drain_scheduled) {
+        state->client_drain_scheduled = true;
+        runner = state->client_runner;
+        client = state->client;
+      }
+    }
+    state->reply_signal.Signal();
+    if (runner) {
+      runner->PostTask(std::make_unique<DrainTask>(client, state, false));
+    }
+  }
+  for (const std::shared_ptr<PortState>& state : data.clients) {
+    base::MutexGuard guard(&state->mutex);
+    state->client_runner.reset();
+    state->outbox.clear();
+    state->outbox_size.store(0, std::memory_order_release);
+  }
+  for (auto* map : {&data.serving, &data.listening}) {
+    for (auto& [raw, handler] : *map) {
+      handler.function.Reset();
+      handler.context.Reset();
+    }
+    map->clear();
+  }
+  // Weak callbacks do not run when an isolate is disposed.
+  for (PortHandle* handle : data.handles) {
+    handle->object.Reset();
+    delete handle;
+  }
+  data.handles.clear();
+  data.ctor.Reset();
+  base::MutexGuard guard(isolates_mutex.Pointer());
+  AllData().erase(isolate);
+}
+
+}  // namespace v8
