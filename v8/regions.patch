+// RegionObjectLiteral ::
+//   '#{' (RegionProperty (',' RegionProperty)* ','?)? '}'
+// RegionProperty ::
+//   (IdentifierName | StringLiteral) ':' AssignmentExpression
+//   IdentifierReference
+// RegionArrayLiteral ::
+//   '#[' (AssignmentExpression (',' AssignmentExpression)* ','?)? ']'
+//
+// Both create their object directly in the current region. They become a
+// runtime call with the keys and values interleaved, or the elements.
+template <typename Impl>
+typename ParserBase<Impl>::ExpressionT ParserBase<Impl>::ParseRegionLiteral() {
+  int pos = peek_position();
+  bool is_object = peek() == Token::kRegionLeftBrace;
+  Consume(peek());
+  Token::Value close = is_object ? Token::kRightBrace : Token::kRightBracket;
+  ExpressionListT args(pointer_buffer());
+  AcceptINScope accept_in(this, true);
+  while (!Check(close)) {
+    if (is_object) {
+      Token::Value token = peek();
+      if (!Token::IsPropertyName(token) && token != Token::kString) {
+        ReportUnexpectedToken(Next());
+        return impl()->FailureExpression();
+      }
+      Consume(token);
+      int key_pos = position();
+      // GetIdentifier(): the preparser needs the name of a shorthand
+      // property to record the variable it refers to.
+      IdentifierT name = token == Token::kString ? impl()->GetSymbol()
+                                                 : impl()->GetIdentifier();
+      args.Add(factory()->NewStringLiteral(name, key_pos));
+      if (token != Token::kString && Token::IsAnyIdentifier(token) &&
+          (peek() == Token::kComma || peek() == close)) {
+        // Shorthand: #{ name } is #{ name: name }.
+        args.Add(impl()->ExpressionFromIdentifier(name, key_pos));
+      } else {
+        Expect(Token::kColon);
+        args.Add(ParseAssignmentExpression());
+      }
+    } else {
+      if (peek() == Token::kComma || peek() == Token::kEllipsis) {
+        ReportUnexpectedToken(Next());
+        return impl()->FailureExpression();
+      }
+      args.Add(ParseAssignmentExpression());
+    }
+    if (peek() != close) {
+      Expect(Token::kComma);
+      if (has_error()) return impl()->FailureExpression();
+    }
+  }
+  expression_scope()->RecordPatternError(
+      Scanner::Location(pos, end_position()),
+      MessageTemplate::kInvalidDestructuringTarget);
+  return impl()->NewRegionLiteral(is_object, args, pos);
+}
