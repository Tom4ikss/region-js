+namespace {
+
+// Finds the value `name` refers to inside `function`, the way the runtime
+// resolves a free variable. Returns false and sets `error` if it cannot be
+// sent to another isolate. Sets `is_builtin` for globals every context has.
+bool ResolveCapture(Isolate* isolate, bool in_probe, Local<Function> function,
+                    const std::string& name, Local<Value>* value,
+                    bool* is_builtin, std::string* error) {
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  i::Handle<i::Context> context(
+      i::Cast<i::JSFunction>(*Utils::OpenDirectHandle(*function))->context(),
+      i_isolate);
+  i::Handle<i::String> i_name =
+      i_isolate->factory()->InternalizeUtf8String(name.c_str());
+  int index;
+  i::PropertyAttributes attributes;
+  i::InitializationFlag init_flag;
+  i::VariableMode mode;
+  i::Handle<i::Object> holder =
+      i::Context::Lookup(context, i_name, i::FOLLOW_CHAINS, &index, &attributes,
+                         &init_flag, &mode);
+  *is_builtin = false;
+  if (holder.is_null() || i::IsJSGlobalObject(*holder)) {
+    if (in_probe) {
+      *is_builtin = true;
+      return true;
+    }
+    if (holder.is_null()) {
+      *error = name + " is not defined";
+      return false;
+    }
+    i::DirectHandle<i::Object> global_value;
+    if (!i::Object::GetProperty(i_isolate, i::Cast<i::JSAny>(holder), i_name)
+             .ToHandle(&global_value)) {
+      return false;
+    }
+    *value = Utils::ToLocal(global_value);
+    return true;
+  }
+  if (index == i::Context::kNotFound) {
+    *error = name + " comes from a module, eval or with and cannot be captured";
+    return false;
+  }
+  i::DirectHandle<i::Context> holder_context = i::Cast<i::Context>(holder);
+  if (init_flag == i::kNeedsInitialization &&
+      holder_context->IsElementTdzHole(index)) {
+    *error = name + " is captured before its initialization";
+    return false;
+  }
+  *value = Utils::ToLocal(i::Context::Get(holder_context, index, i_isolate));
+  return true;
+}
+
+}  // namespace
+
+// Region.prepareSpawn(fn) finds out what `fn` needs to run in another isolate:
+//   { source, functions: { name: source }, captures: { name: value } }
+// Free variables of `fn` and of the functions it captures are resolved in their
+// closures: data is returned in `captures`, functions are sent as source and
+// analyzed the same way. Throws a TypeError for anything that cannot be sent.
+void Shell::RegionPrepareSpawn(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Isolate* isolate = info.GetIsolate();
+  Local<Context> context = isolate->GetCurrentContext();
+  auto throw_type_error = [isolate](const std::string& message) {
+    isolate->ThrowException(Exception::TypeError(
+        String::NewFromUtf8(isolate, message.c_str()).ToLocalChecked()));
+  };
+  if (info.Length() < 1 || !info[0]->IsFunction()) {
+    throw_type_error("spawn() expects a function");
+    return;
+  }
+
+  PerIsolateData* data = PerIsolateData::Get(isolate);
+  Local<Context> probe = data->GetSpawnProbeContext();
+  if (probe.IsEmpty()) {
+    if (!CreateEvaluationContext(isolate).ToLocal(&probe)) return;
+    data->SetSpawnProbeContext(probe);
+  }
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+
+  struct Pending {
+    std::string name;  // Empty for the callback itself.
+    Local<Function> function;
+  };
+  std::vector<Pending> worklist = {{"", info[0].As<Function>()}};
+  std::vector<std::pair<std::string, Local<Function>>> functions;
+  std::vector<std::pair<std::string, Local<Value>>> captures;
+  Local<Value> receiver;
+  Local<Value> arguments_list;
+  Local<String> root_source;
+  std::vector<std::pair<std::string, Local<String>>> function_sources;
+  std::string error;
+  // Identifies the code the worker compiles: the analyses of the callback and
+  // of the functions it captures.
+  std::string code_key;
+
+  while (!worklist.empty() && error.empty()) {
+    Pending current = worklist.back();
+    worklist.pop_back();
+    const std::string label =
+        current.name.empty() ? "spawn() callback" : "captured function " + current.name;
+    using Analysis = PerIsolateData::SpawnAnalysis;
+    Analysis* analysis = nullptr;
+    Analysis uncached{-1, {}, {}, Analysis::Failure::kNotCompiled};
+    std::optional<std::tuple<int, int, int>> key;
+    {
+      i::DirectHandle<i::Object> raw = Utils::OpenDirectHandle(*current.function);
+      if (i::IsJSFunction(*raw)) {
+        i::Tagged<i::SharedFunctionInfo> shared =
+            i::Cast<i::JSFunction>(*raw)->shared();
+        if (i::IsScript(shared->script())) {
+          key = {i::Cast<i::Script>(shared->script())->id(),
+                 shared->StartPosition(), shared->EndPosition()};
+        }
+      }
+    }
+    if (key) {
+      auto it = data->spawn_analyses_.find(*key);
+      if (it != data->spawn_analyses_.end()) analysis = &it->second;
+    }
+    if (!analysis) {
+      Local<String> source;
+      if (!current.function->FunctionProtoToString(context).ToLocal(&source)) {
+        return;
+      }
+      std::set<std::string> names;
+      bool uses_dynamic_scope = false;
+      bool uses_classes = false;
+      bool compiled = false;
+      {
+        Context::Scope probe_scope(probe);
+        TryCatch try_catch(isolate);
+        Local<String> wrapped = String::Concat(
+            isolate, String::NewFromUtf8Literal(isolate, "("),
+            String::Concat(isolate, source,
+                           String::NewFromUtf8Literal(isolate, "\n)")));
+        Local<Script> script;
+        Local<Value> probe_function;
+        if (Script::Compile(probe, wrapped).ToLocal(&script) &&
+            script->Run(probe).ToLocal(&probe_function) &&
+            probe_function->IsFunction()) {
+          i::Handle<i::SharedFunctionInfo> shared(
+              i::Cast<i::JSFunction>(*Utils::OpenDirectHandle(*probe_function))
+                  ->shared(),
+              i_isolate);
+          compiled = CollectGlobalNames(i_isolate, shared, &names,
+                                        &uses_dynamic_scope, &uses_classes);
+        }
+      }
+      Analysis fresh{static_cast<int>(data->spawn_analyses_.size()),
+                     Global<String>(isolate, source),
+                     {},
+                     !compiled             ? Analysis::Failure::kNotCompiled
+                     : uses_dynamic_scope  ? Analysis::Failure::kDynamicScope
+                     : uses_classes        ? Analysis::Failure::kClasses
+                                           : Analysis::Failure::kNone};
+      for (const std::string& name : names) {
+        bool in_probe =
+            probe->Global()
+                ->Has(probe,
+                      String::NewFromUtf8(isolate, name.c_str()).ToLocalChecked())
+                .FromMaybe(false);
+        fresh.names.emplace_back(name, in_probe);
+      }
+      if (key) {
+        analysis =
+            &data->spawn_analyses_.emplace(*key, std::move(fresh)).first->second;
+      } else {
+        uncached = std::move(fresh);
+        analysis = &uncached;
+      }
+    }
+    Local<String> source = analysis->source.Get(isolate);
+    code_key += std::to_string(analysis->id) + ":";
+    if (analysis->failure == Analysis::Failure::kNotCompiled) {
+      error = current.name.empty()
+                  ? "spawn() needs an arrow function or a function expression"
+                  : label + " is native, bound or a method and cannot be sent";
+      break;
+    }
+    if (analysis->failure == Analysis::Failure::kDynamicScope) {
+      error = label + " cannot use eval or with";
+      break;
+    }
+    if (analysis->failure == Analysis::Failure::kClasses) {
+      error = label + " declares or is a class; classes are not supported";
+      break;
+    }
+
+    for (const auto& [name, in_probe] : analysis->names) {
+      Local<Value> value;
+      bool is_builtin;
+      {
+        TryCatch try_catch(isolate);
+        if (!ResolveCapture(isolate, in_probe, current.function, name, &value,
+                            &is_builtin, &error)) {
+          if (error.empty()) error = "cannot read " + name;
+          break;
+        }
+      }
+      // A name may hold a function in one call and data in another, which
+      // needs different code.
+      code_key += is_builtin ? 'b' : value->IsFunction() ? 'f' : 'd';
+      if (is_builtin) continue;
+
+      if (name == "this" || name == "arguments") {
+        // The lexical receiver and arguments of an arrow function. The global
+        // receiver needs no capture: the worker has its own.
+        i::DirectHandle<i::Object> raw = Utils::OpenDirectHandle(*value);
+        if (name == "this" &&
+            (i::IsJSGlobalObject(*raw) || i::IsJSGlobalProxy(*raw))) {
+          continue;
+        }
+        if (!current.name.empty()) {
+          error = label + " uses " + name + " of its closure";
+          break;
+        }
+        (name == "this" ? receiver : arguments_list) = value;
+        continue;
+      }
+
+      if (value->IsFunction()) {
+        Local<Function> function = value.As<Function>();
+        auto known = std::find_if(functions.begin(), functions.end(),
+                                  [&](const auto& f) { return f.first == name; });
+        if (known != functions.end()) {
+          if (!known->second->StrictEquals(function)) {
+            error = name + " refers to different functions in different places";
+          }
+        } else {
+          functions.emplace_back(name, function);
+          worklist.push_back({name, function});
+        }
+      } else {
+        auto known = std::find_if(captures.begin(), captures.end(),
+                                  [&](const auto& c) { return c.first == name; });
+        if (known != captures.end()) {
+          if (!known->second->StrictEquals(value)) {
+            error = name + " refers to different values in different places";
+          }
+        } else {
+          captures.emplace_back(name, value);
+        }
+      }
+      if (!error.empty()) break;
+    }
+
+    if (current.name.empty()) {
+      root_source = source;
+    } else if (error.empty()) {
+      function_sources.emplace_back(current.name, source);
+    }
+  }
+
+  if (!error.empty()) {
+    throw_type_error(error);
+    return;
+  }
+
+  // [code id, receiver, arguments, ...captured values]; the code itself is
+  // available from Region.spawnCode(id) and is the same for every call with
+  // that id.
+  auto [code, inserted] = data->spawn_code_ids_.try_emplace(
+      code_key, static_cast<int>(data->spawn_codes_.size()));
+  if (inserted) {
+    PerIsolateData::SpawnCode entry;
+    entry.source.Reset(isolate, root_source);
+    for (const auto& [name, source] : function_sources) {
+      entry.functions.emplace_back(name, Global<String>(isolate, source));
+    }
+    for (const auto& [name, value] : captures) entry.names.push_back(name);
+    data->spawn_codes_.push_back(std::move(entry));
+  }
+  std::vector<Local<Value>> elements;
+  elements.reserve(3 + captures.size());
+  elements.push_back(Integer::New(isolate, code->second));
+  elements.push_back(receiver.IsEmpty() ? Undefined(isolate).As<Value>()
+                                        : receiver);
+  elements.push_back(arguments_list.IsEmpty()
+                         ? Undefined(isolate).As<Value>()
+                         : arguments_list);
+  for (const auto& [name, value] : captures) elements.push_back(value);
+  info.GetReturnValue().Set(
+      Array::New(isolate, elements.data(), elements.size()));
+}
+
+// Region.spawnCode(id) -> { source, functions: { name: source }, names }
+void Shell::RegionSpawnCode(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Isolate* isolate = info.GetIsolate();
+  Local<Context> context = isolate->GetCurrentContext();
+  PerIsolateData* data = PerIsolateData::Get(isolate);
+  int id = info.Length() > 0 && info[0]->IsInt32()
+               ? info[0].As<Int32>()->Value()
+               : -1;
+  if (id < 0 || id >= static_cast<int>(data->spawn_codes_.size())) {
+    ThrowError(isolate, "Region.spawnCode() expects a code id");
+    return;
+  }
+  const PerIsolateData::SpawnCode& code = data->spawn_codes_[id];
+  Local<Object> functions = Object::New(isolate);
+  for (const auto& [name, source] : code.functions) {
+    functions
+        ->Set(context, String::NewFromUtf8(isolate, name.c_str()).ToLocalChecked(),
+              source.Get(isolate))
+        .Check();
+  }
+  std::vector<Local<Value>> names;
+  for (const std::string& name : code.names) {
+    names.push_back(String::NewFromUtf8(isolate, name.c_str()).ToLocalChecked());
+  }
+  Local<Object> result = Object::New(isolate);
+  result
+      ->Set(context, String::NewFromUtf8Literal(isolate, "source"),
+            code.source.Get(isolate))
+      .Check();
+  result->Set(context, String::NewFromUtf8Literal(isolate, "functions"), functions)
+      .Check();
+  result
+      ->Set(context, String::NewFromUtf8Literal(isolate, "names"),
+            Array::New(isolate, names.data(), names.size()))
+      .Check();
+  info.GetReturnValue().Set(result);
+}
+
+// region.run(fn, transfer) copies the result of fn into the region. Typed
+// arrays whose ArrayBuffer is in the transfer array move without copying and
+// the buffers are detached; `true` transfers every buffer (used by spawn for
+// results that nothing else refers to).
+void Shell::RegionRun(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Isolate* isolate = info.GetIsolate();
+  if (info.Length() < 1 || !info[0]->IsFunction()) {
+    ThrowError(isolate, "region.run() expects a function");
+    return;
+  }
+  Local<Context> context = isolate->GetCurrentContext();
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  i::DirectHandleVector<i::JSArrayBuffer> transfer(i_isolate);
+  bool transfer_all = info.Length() > 1 && info[1]->IsTrue();
+  if (info.Length() > 1 && info[1]->IsArray()) {
+    Local<Array> list = info[1].As<Array>();
+    for (uint32_t i = 0; i < list->Length(); i++) {
+      Local<Value> item;
+      if (!list->Get(context, i).ToLocal(&item)) return;
+      if (!item->IsArrayBuffer()) {
+        ThrowError(isolate, "region.run() transfer list must contain ArrayBuffers");
+        return;
+      }
+      transfer.push_back(
+          i::Cast<i::JSArrayBuffer>(Utils::OpenDirectHandle(*item)));
+    }
+  }
+  // Inside fn the region is the current one, for Region.object() and
+  // Region.array().
+  int region = RegionIdOf(info);
+  i::JSRegionObject::PushCurrent(i_isolate, region);
+  Local<Value> result;
+  bool called = info[0].As<Function>()
+                    ->Call(context, Undefined(isolate), 0, nullptr)
+                    .ToLocal(&result);
+  i::JSRegionObject::PopCurrent(i_isolate, region);
+  if (!called) return;
+  i::DirectHandle<i::Object> evacuated;
+  if (!i::JSRegionObject::Evacuate(i_isolate, RegionIdOf(info),
+                                   Utils::OpenDirectHandle(*result), &transfer,
+                                   transfer_all)
+           .ToHandle(&evacuated)) {
+    return;
+  }
+  i::Handle<i::Object> value;
+  if (i::JSRegionObject::ToJSValue(i_isolate,
+                                   i::indirect_handle(evacuated, i_isolate))
+          .ToHandle(&value)) {
+    info.GetReturnValue().Set(Utils::ToLocal(value));
+  }
+}
+
+namespace {
+
+// Copies `value` into `region` and returns what JS sees of it.
+void CreateInRegion(const v8::FunctionCallbackInfo<v8::Value>& info,
+                    int region, Local<Value> value) {
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(info.GetIsolate());
+  i::DirectHandle<i::Object> evacuated;
+  if (!i::JSRegionObject::Evacuate(i_isolate, region,
+                                   Utils::OpenDirectHandle(*value), nullptr,
+                                   false)
+           .ToHandle(&evacuated)) {
+    return;
+  }
+  i::Handle<i::Object> result;
+  if (i::JSRegionObject::ToJSValue(i_isolate,
+                                   i::indirect_handle(evacuated, i_isolate))
+          .ToHandle(&result)) {
+    info.GetReturnValue().Set(Utils::ToLocal(result));
+  }
+}
+
+bool CheckObjectArgument(const v8::FunctionCallbackInfo<v8::Value>& info,
+                         const char* name) {
+  if (info.Length() < 1 || !info[0]->IsObject() || info[0]->IsArray() ||
+      info[0]->IsFunction()) {
+    std::string message =
+        std::string(name) + "() expects a plain object; use array() for arrays";
+    info.GetIsolate()->ThrowException(Exception::TypeError(
+        String::NewFromUtf8(info.GetIsolate(), message.c_str())
+            .ToLocalChecked()));
+    return false;
+  }
+  return true;
+}
+
+MaybeLocal<Array> ArgumentsArray(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  std::vector<Local<Value>> items;
+  for (int i = 0; i < info.Length(); i++) items.push_back(info[i]);
+  return Array::New(info.GetIsolate(), items.data(), items.size());
+}
+
+int CurrentRegion(const v8::FunctionCallbackInfo<v8::Value>& info,
+                  const char* name) {
+  int region = i::JSRegionObject::Current(
+      reinterpret_cast<i::Isolate*>(info.GetIsolate()));
+  if (region < 0) {
+    std::string message = std::string("Region.") + name +
+                          "() needs a current region: use region.enter() or "
+                          "region." + name + "()";
+    info.GetIsolate()->ThrowException(Exception::TypeError(
+        String::NewFromUtf8(info.GetIsolate(), message.c_str())
+            .ToLocalChecked()));
+    return -1;
+  }
+  return region;
+}
