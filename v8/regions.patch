+
+void Shell::RegionFreeze(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  int region = RegionIdOf(info);
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(info.GetIsolate());
+  // Writable typed array views would let the owner change frozen bytes.
+  if (i::RegionRegistry::IsOwner(region, i_isolate)) {
+    i::JSRegionObject::DetachViews(i_isolate, region);
+  }
+  if (i::RegionRegistry::Freeze(region, i_isolate)) return;
+  ThrowError(info.GetIsolate(),
+             i::RegionRegistry::IsFreed(region)    ? "Region was freed"
+             : i::RegionRegistry::IsFrozen(region) ? "Region is already frozen"
+                                                   : "Region is not owned by this isolate");
+}
+
+void Shell::RegionThaw(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Isolate* isolate = info.GetIsolate();
+  int region = RegionIdOf(info);
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  switch (i::RegionRegistry::Thaw(region, i_isolate)) {
+    case i::RegionRegistry::ThawResult::kThawed:
+      // Views taken while frozen are immutable and would outlive the freeze;
+      // reading the field again gives a writable one.
+      i::JSRegionObject::DetachViews(i_isolate, region);
+      return;
+    case i::RegionRegistry::ThawResult::kBorrowed: {
+      std::string message =
+          "Region is still borrowed by " +
+          std::to_string(i::RegionRegistry::Readers(region)) + " reader(s)";
+      ThrowError(isolate, message.c_str());
+      return;
+    }
+    case i::RegionRegistry::ThawResult::kNotFrozenByIsolate:
+      ThrowError(isolate, i::RegionRegistry::IsFreed(region)
+                              ? "Region was freed"
+                              : "Region is not frozen by this isolate");
+      return;
+  }
+}
+
+void Shell::RegionBorrow(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Isolate* isolate = info.GetIsolate();
+  int region = RegionIdOf(info);
+  Local<Object> borrow;
+  if (!PerIsolateData::Get(isolate)
+           ->GetRegionBorrowCtor()
+           ->InstanceTemplate()
+           ->NewInstance(isolate->GetCurrentContext())
+           .ToLocal(&borrow)) {
+    return;
+  }
+  if (!i::RegionRegistry::Borrow(region,
+                                 reinterpret_cast<i::Isolate*>(isolate))) {
+    ThrowError(isolate, i::RegionRegistry::IsFreed(region)
+                            ? "Region was freed"
+                            : "Region must be frozen to borrow it");
+    return;
+  }
+  borrow->SetInternalField(0, Int32::New(isolate, region));
+  borrow->SetInternalField(1, v8::False(isolate));
+  info.GetReturnValue().Set(borrow);
+}
+
+void Shell::RegionBorrowRelease(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Local<Object> borrow = info.This();
+  if (borrow->GetInternalField(1).As<Value>()->IsTrue()) return;
+  borrow->SetInternalField(1, v8::True(info.GetIsolate()));
+  i::RegionRegistry::Unborrow(
+      borrow->GetInternalField(0).As<Int32>()->Value(),
+      reinterpret_cast<i::Isolate*>(info.GetIsolate()));
+}
+
+void Shell::RegionFrozen(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  info.GetReturnValue().Set(i::RegionRegistry::IsFrozen(RegionIdOf(info)));
+}
