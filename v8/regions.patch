+#include <cmath>
+#include <deque>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "include/v8-container.h"
+#include "include/v8-context.h"
+#include "include/v8-exception.h"
+#include "include/v8-external.h"
+#include "include/v8-function.h"
+#include "include/v8-isolate.h"
+#include "include/v8-object.h"
+#include "include/v8-persistent-handle.h"
+#include "include/v8-platform.h"
+#include "include/v8-primitive.h"
+#include "include/v8-promise.h"
+#include "src/base/lazy-instance.h"
+#include "src/base/macros.h"
+#include "src/base/platform/semaphore.h"
+#include "src/base/platform/mutex.h"
+#include "src/base/platform/time.h"
+#include "src/d8/d8-port.h"
+#include "src/d8/d8.h"
+#include "src/execution/isolate.h"
+#include "src/heap/parked-scope-inl.h"
+#include "src/init/v8.h"
+
+namespace v8 {
+
+// A value in a channel: primitives, strings, region objects and channels go
+// natively, like task port messages; other data through the serializer, so
+// that plain objects are copied as with postMessage().
+struct ChannelValue {
+  std::unique_ptr<SerializationData> serialized;
+  std::unique_ptr<PortMessage> native;
+};
+
+// A pending send or receive of one isolate. A receive may wait on several
+// channels at once (select); whichever delivers first completes it.
+struct ChannelWaiter {
+  enum class Kind { kReceive, kSend };
+
+  ChannelWaiter(Kind kind, Isolate* isolate, bool blocking, uint64_t id)
+      : kind(kind), isolate(isolate), blocking(blocking), id(id) {}
+
+  const Kind kind;
+  Isolate* const isolate;
+  const bool blocking;
+  const uint64_t id;
+
+  // Guarded by the channels mutex.
+  bool done = false;
+  // Receive: which of the channels completed it, and whether it was closed.
+  int index = -1;
+  bool closed = false;
+  std::unique_ptr<ChannelValue> data;
+  // The channel `data` came from, to give it back if nobody picks it up.
+  std::shared_ptr<ChannelState> source;
+  // The channels the waiter is registered with.
+  std::vector<std::shared_ptr<ChannelState>> channels;
+  // Signalled when a blocking waiter completes or is cancelled because its
+  // isolate is terminated.
+  base::Semaphore completed{0};
+  // Set together with the signal, for a waiter that spins before blocking.
+  std::atomic<bool> ready{false};
+  bool cancelled = false;
+};
+
+struct ChannelState {
+  explicit ChannelState(size_t capacity) : capacity(capacity) {}
+
+  struct Item {
+    std::unique_ptr<ChannelValue> data;
+    // An item is accepted once it fits into the buffer; until then its
+    // sender waits.
+    bool accepted;
+    std::shared_ptr<ChannelWaiter> sender;
+  };
+  struct Receiver {
+    std::shared_ptr<ChannelWaiter> waiter;
+    int index;
+  };
+
+  const size_t capacity;
+  // Guarded by the channels mutex. Accepted items always come first.
+  bool closed = false;
+  size_t accepted = 0;
+  std::deque<Item> items;
+  std::deque<Receiver> receivers;
+};
+
+namespace {
+
+// One mutex for all channels keeps select() simple.
+base::LazyMutex channels_mutex = LAZY_MUTEX_INITIALIZER;
+
+constexpr ExternalPointerTypeTag kChannelTag = kExternalPointerTypeTagDefault;
+
+// A Channel object of an isolate and the state it keeps alive.
+struct ChannelHandle {
+  std::shared_ptr<ChannelState> state;
+  Global<Object> object;
+};
+
+struct PendingWait {
+  std::shared_ptr<ChannelWaiter> waiter;
+  Global<Promise::Resolver> resolver;
+  Global<Context> context;
+};
+
+// Per-isolate bookkeeping. Only the isolate's own thread touches its entry;
+// the map itself is shared.
+struct IsolateChannels {
+  Global<FunctionTemplate> ctor;
+  std::unordered_map<uint64_t, PendingWait> pending;
+  std::unordered_set<ChannelHandle*> handles;
+  uint64_t next_id = 1;
+};
+
+base::LazyMutex isolates_mutex = LAZY_MUTEX_INITIALIZER;
+
+// Guarded by the channels mutex: threads blocked in a channel operation, and
+// isolates being terminated, whose waiters must not get values any more.
+std::unordered_set<ChannelWaiter*>& BlockingWaiters() {
+  static base::LeakyObject<std::unordered_set<ChannelWaiter*>> waiters;
+  return *waiters.get();
+}
+std::unordered_set<Isolate*>& TerminatingIsolates() {
+  static base::LeakyObject<std::unordered_set<Isolate*>> isolates;
+  return *isolates.get();
+}
+
+std::unordered_map<Isolate*, IsolateChannels>& AllData() {
+  static base::LeakyObject<std::unordered_map<Isolate*, IsolateChannels>> all;
+  return *all.get();
+}
+
+// Elements of an unordered_map keep their address, so the entry can be used
+// without the lock.
+IsolateChannels& DataOf(Isolate* isolate) {
+  base::MutexGuard guard(isolates_mutex.Pointer());
+  return AllData()[isolate];
+}
+
+void ThrowTypeError(Isolate* isolate, const char* message) {
+  isolate->ThrowException(Exception::TypeError(
+      String::NewFromUtf8(isolate, message).ToLocalChecked()));
+}
+
+// Wakes the isolate of a completed asynchronous waiter: the promise is
+// settled on its own thread.
+class WakeTask : public Task {
+ public:
+  WakeTask(Isolate* isolate, uint64_t id) : isolate_(isolate), id_(id) {}
+  void Run() override;
+
+ private:
+  Isolate* const isolate_;
+  const uint64_t id_;
+};
+
+// The following functions run with the channels mutex held.
+
+void CompleteLocked(const std::shared_ptr<ChannelWaiter>& waiter) {
+  waiter->done = true;
+  for (const std::shared_ptr<ChannelState>& state : waiter->channels) {
+    std::erase_if(state->receivers, [&](const ChannelState::Receiver& r) {
+      return r.waiter == waiter;
+    });
+  }
+  waiter->channels.clear();
+  if (waiter->blocking) {
+    waiter->ready.store(true, std::memory_order_release);
+    waiter->completed.Signal();
+  } else {
+    i::V8::GetCurrentPlatform()
+        ->GetForegroundTaskRunner(waiter->isolate)
+        ->PostTask(std::make_unique<WakeTask>(waiter->isolate, waiter->id));
+  }
+}
+
+void CancelLocked(ChannelWaiter* waiter) {
+  if (waiter->done) return;
+  waiter->done = true;
+  for (const std::shared_ptr<ChannelState>& state : waiter->channels) {
+    std::erase_if(state->receivers, [&](const ChannelState::Receiver& r) {
+      return r.waiter.get() == waiter;
+    });
+    // A cancelled sender leaves its value in the channel.
+    for (ChannelState::Item& item : state->items) {
+      if (item.sender.get() == waiter) item.sender = nullptr;
+    }
+  }
+  waiter->channels.clear();
+}
+
+// The next receiver that can still take a value, or null.
+std::shared_ptr<ChannelWaiter> NextReceiverLocked(ChannelState* state,
+                                                  int* index) {
+  while (!state->receivers.empty()) {
+    ChannelState::Receiver receiver = std::move(state->receivers.front());
+    state->receivers.pop_front();
+    if (TerminatingIsolates().contains(receiver.waiter->isolate)) {
+      CancelLocked(receiver.waiter.get());
+      continue;
+    }
+    *index = receiver.index;
+    return receiver.waiter;
+  }
+  return nullptr;
+}
+
+void DeliverLocked(const std::shared_ptr<ChannelState>& state,
+                   ChannelState::Receiver receiver,
+                   std::unique_ptr<ChannelValue> data) {
+  receiver.waiter->data = std::move(data);
+  receiver.waiter->index = receiver.index;
+  receiver.waiter->source = state;
+  CompleteLocked(receiver.waiter);
+}
+
+// A value delivered to an isolate that went away before reading it goes back
+// to the front of its channel, so it is not lost with the regions it moves.
+void ReturnUndeliveredLocked(ChannelWaiter* waiter) {
+  if (!waiter->data || !waiter->source) return;
+  std::shared_ptr<ChannelState> state = std::move(waiter->source);
+  int index;
+  if (std::shared_ptr<ChannelWaiter> next =
+          NextReceiverLocked(state.get(), &index)) {
+    DeliverLocked(state, {std::move(next), index}, std::move(waiter->data));
+    return;
+  }
+  state->items.push_front({std::move(waiter->data), true, nullptr});
+  state->accepted++;
+}
+
+// Accepts waiting items while the buffer has room.
+void PromoteLocked(ChannelState* state) {
+  while (state->accepted < state->items.size() &&
+         (state->accepted < state->capacity || state->closed)) {
+    ChannelState::Item& item = state->items[state->accepted++];
+    item.accepted = true;
+    if (item.sender) {
+      CompleteLocked(item.sender);
+      item.sender = nullptr;
+    }
+  }
+}
+
+bool TakeLocked(ChannelState* state,
+                std::unique_ptr<ChannelValue>* data) {
+  if (state->items.empty()) return false;
+  ChannelState::Item item = std::move(state->items.front());
+  state->items.pop_front();
+  if (item.accepted) {
+    state->accepted--;
+  } else if (item.sender) {
+    // Unbuffered: the sender waited for exactly this.
+    CompleteLocked(item.sender);
+  }
+  PromoteLocked(state);
+  *data = std::move(item.data);
+  return true;
+}
+
+// Blocks until the waiter completes. Returns false, with the termination
+// exception pending, if the isolate is terminated meanwhile. The thread is
+// parked while it waits: a shared heap GC must not wait for it, or a sender
+// that needs the GC would never come. Nothing that may allocate runs with the
+// channels mutex held.
+bool WaitBlocking(const std::shared_ptr<ChannelWaiter>& waiter) {
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(waiter->isolate);
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    BlockingWaiters().insert(waiter.get());
+  }
+  // Worker.terminate() cancels the wait (Channels::TerminateIsolate); the
+  // timeout only covers other ways to terminate an isolate.
+  i_isolate->main_thread_local_isolate()->ExecuteMainThreadWhileParked(
+      [&](const i::ParkedScope&) {
+        if (Shell::SpinUntil([&] {
+              return waiter->ready.load(std::memory_order_acquire);
+            })) {
+          return;
+        }
+        while (!waiter->completed.WaitFor(
+            base::TimeDelta::FromMilliseconds(50))) {
+          if (!i_isolate->stack_guard()->HasTerminationRequest() &&
+              !i_isolate->is_execution_terminating()) {
+            continue;
+          }
+          // HasTerminationRequest() consumed the request; ask again so the
+          // isolate still terminates.
+          waiter->isolate->TerminateExecution();
+          base::MutexGuard guard(channels_mutex.Pointer());
+          if (waiter->done) {
+            ReturnUndeliveredLocked(waiter.get());
+          } else {
+            CancelLocked(waiter.get());
+          }
+          waiter->cancelled = true;
+          return;
+        }
+      });
+  base::MutexGuard guard(channels_mutex.Pointer());
+  BlockingWaiters().erase(waiter.get());
+  return !waiter->cancelled;
+}
+
+// {value, done, index} for a completed receive.
+MaybeLocal<Object> MakeResult(Isolate* isolate, Local<Context> context,
+                              int index, bool closed,
+                              std::unique_ptr<ChannelValue> data) {
+  Local<Value> value = Undefined(isolate);
+  if (data) {
+    MaybeLocal<Value> maybe =
+        data->native ? Ports::UnmarshalValue(isolate, data->native.get())
+                     : Shell::DeserializeValue(isolate,
+                                               std::move(data->serialized));
+    if (!maybe.ToLocal(&value)) return {};
+  }
+  Local<Object> result = Object::New(isolate);
+  if (result
+          ->CreateDataProperty(context,
+                               String::NewFromUtf8Literal(isolate, "value"),
+                               value)
+          .IsNothing() ||
+      result
+          ->CreateDataProperty(context,
+                               String::NewFromUtf8Literal(isolate, "done"),
+                               Boolean::New(isolate, closed))
+          .IsNothing() ||
+      result
+          ->CreateDataProperty(context,
+                               String::NewFromUtf8Literal(isolate, "index"),
+                               Integer::New(isolate, index))
+          .IsNothing()) {
+    return {};
+  }
+  return result;
+}
+
+Local<Promise> AddPending(Isolate* isolate,
+                          std::shared_ptr<ChannelWaiter> waiter) {
+  Local<Context> context = isolate->GetCurrentContext();
+  Local<Promise::Resolver> resolver =
+      Promise::Resolver::New(context).ToLocalChecked();
+  PendingWait pending{std::move(waiter), Global<Promise::Resolver>(),
+                      Global<Context>()};
+  pending.resolver.Reset(isolate, resolver);
+  pending.context.Reset(isolate, context);
+  IsolateChannels& data = DataOf(isolate);
+  uint64_t id = pending.waiter->id;
+  data.pending.emplace(id, std::move(pending));
+  return resolver->GetPromise();
+}
+
+void WakeTask::Run() {
+  IsolateChannels& data = DataOf(isolate_);
+  auto it = data.pending.find(id_);
+  if (it == data.pending.end()) return;
+  // Terminating: the value could not be deserialized; ForgetIsolate gives it
+  // back to the channel.
+  if (isolate_->IsExecutionTerminating()) return;
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    if (TerminatingIsolates().contains(isolate_)) return;
+  }
+  PendingWait pending = std::move(it->second);
+  data.pending.erase(it);
+
+  HandleScope scope(isolate_);
+  Local<Context> context = pending.context.Get(isolate_);
+  Context::Scope context_scope(context);
+  Local<Promise::Resolver> resolver = pending.resolver.Get(isolate_);
+  pending.resolver.Reset();
+  pending.context.Reset();
+
+  ChannelWaiter* waiter = pending.waiter.get();
+  if (waiter->kind == ChannelWaiter::Kind::kSend) {
+    USE(resolver->Resolve(context, Undefined(isolate_)));
+    return;
+  }
+  std::unique_ptr<ChannelValue> received;
+  int index;
+  bool closed;
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    received = std::move(waiter->data);
+    index = waiter->index;
+    closed = waiter->closed;
+  }
+  TryCatch try_catch(isolate_);
+  Local<Object> result;
+  if (MakeResult(isolate_, context, index, closed, std::move(received))
+          .ToLocal(&result)) {
+    USE(resolver->Resolve(context, result));
+  } else if (try_catch.HasCaught() && !try_catch.HasTerminated()) {
+    USE(resolver->Reject(context, try_catch.Exception()));
+  }
+}
+
+std::shared_ptr<ChannelState> StateOf(Isolate* isolate, Local<Value> value) {
+  return Channels::FromValue(isolate, value);
+}
+
+void Attach(Isolate* isolate, Local<Object> object,
+            std::shared_ptr<ChannelState> state) {
+  auto* handle = new ChannelHandle{std::move(state), Global<Object>()};
+  handle->object.Reset(isolate, object);
+  handle->object.SetWeak(
+      handle,
+      [](const WeakCallbackInfo<ChannelHandle>& info) {
+        ChannelHandle* handle = info.GetParameter();
+        DataOf(info.GetIsolate()).handles.erase(handle);
+        handle->object.Reset();
+        delete handle;
+      },
+      WeakCallbackType::kParameter);
+  object->SetInternalField(0, External::New(isolate, handle, kChannelTag));
+  DataOf(isolate).handles.insert(handle);
+}
+
+void ChannelNew(const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  if (!info.IsConstructCall()) {
+    ThrowTypeError(isolate, "Channel constructor requires 'new'");
+    return;
+  }
+  double capacity = 0;
+  if (info.Length() > 0 && !info[0]->IsUndefined()) {
+    if (!info[0]->NumberValue(isolate->GetCurrentContext()).To(&capacity)) {
+      return;
+    }
+    if (!(capacity >= 0 && capacity <= (1 << 30) &&
+          capacity == std::floor(capacity))) {
+      isolate->ThrowException(Exception::RangeError(String::NewFromUtf8Literal(
+          isolate, "Channel capacity must be a non-negative integer")));
+      return;
+    }
+  }
+  Attach(isolate, info.This(),
+         std::make_shared<ChannelState>(static_cast<size_t>(capacity)));
+}
+
+std::shared_ptr<ChannelState> ThisState(const FunctionCallbackInfo<Value>& info) {
+  std::shared_ptr<ChannelState> state = StateOf(info.GetIsolate(), info.This());
+  if (!state) ThrowTypeError(info.GetIsolate(), "this is not a Channel");
+  return state;
+}
+
+// __send(value, transfer, blocking): resolves (or returns) once the value is
+// in the buffer or taken by a receiver.
+void ChannelSend(const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  std::shared_ptr<ChannelState> state = ThisState(info);
+  if (!state) return;
+  bool blocking = info[2]->IsTrue();
+  bool closed;
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    closed = state->closed;
+  }
+  if (closed) {
+    ThrowTypeError(isolate, "send on a closed channel");
+    return;
+  }
+  auto data = std::make_unique<ChannelValue>();
+  bool native;
+  data->native = Ports::MarshalValue(isolate, info[0], info[1], &native);
+  if (native) {
+    if (!data->native) return;
+  } else {
+    data->serialized = Shell::SerializeValue(isolate, info[0], info[1]);
+    if (!data->serialized) return;
+  }
+
+  std::shared_ptr<ChannelWaiter> waiter;
+  uint64_t id = blocking ? 0 : DataOf(isolate).next_id++;
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    int index;
+    if (std::shared_ptr<ChannelWaiter> receiver =
+            NextReceiverLocked(state.get(), &index)) {
+      DeliverLocked(state, {std::move(receiver), index}, std::move(data));
+    } else if (state->accepted < state->capacity || state->closed) {
+      // Closed while serializing: the value was sent before the close.
+      state->items.push_back({std::move(data), true, nullptr});
+      state->accepted++;
+    } else {
+      waiter = std::make_shared<ChannelWaiter>(ChannelWaiter::Kind::kSend,
+                                               isolate, blocking, id);
+      state->items.push_back({std::move(data), false, waiter});
+      waiter->channels.push_back(state);
+    }
+  }
+  if (!waiter) {
+    if (!blocking) {
+      Local<Promise::Resolver> resolver =
+          Promise::Resolver::New(isolate->GetCurrentContext())
+              .ToLocalChecked();
+      USE(resolver->Resolve(isolate->GetCurrentContext(), Undefined(isolate)));
+      info.GetReturnValue().Set(resolver->GetPromise());
+    }
+    return;
+  }
+  if (blocking) {
+    WaitBlocking(waiter);
+  } else {
+    info.GetReturnValue().Set(AddPending(isolate, std::move(waiter)));
+  }
+}
+
+// Receives from the first of `states` that has a value or is closed.
+void Receive(const FunctionCallbackInfo<Value>& info,
+             std::vector<std::shared_ptr<ChannelState>> states,
+             bool blocking) {
+  Isolate* isolate = info.GetIsolate();
+  Local<Context> context = isolate->GetCurrentContext();
+  static thread_local uint32_t rotation = 0;
+  size_t count = states.size();
+  size_t start = count > 1 ? rotation++ % count : 0;
+
+  std::unique_ptr<ChannelValue> data;
+  int index = -1;
+  bool closed = false;
+  std::shared_ptr<ChannelWaiter> waiter;
+  uint64_t id = blocking ? 0 : DataOf(isolate).next_id++;
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    for (size_t k = 0; k < count && index < 0; k++) {
+      size_t i = (start + k) % count;
+      if (TakeLocked(states[i].get(), &data)) index = static_cast<int>(i);
+    }
+    for (size_t k = 0; k < count && index < 0; k++) {
+      size_t i = (start + k) % count;
+      if (states[i]->closed) {
+        index = static_cast<int>(i);
+        closed = true;
+      }
+    }
+    if (index < 0) {
+      waiter = std::make_shared<ChannelWaiter>(ChannelWaiter::Kind::kReceive,
+                                               isolate, blocking, id);
+      for (size_t i = 0; i < count; i++) {
+        states[i]->receivers.push_back({waiter, static_cast<int>(i)});
+        waiter->channels.push_back(states[i]);
+      }
+    }
+  }
+
+  if (waiter && !blocking) {
+    info.GetReturnValue().Set(AddPending(isolate, std::move(waiter)));
+    return;
+  }
+  if (waiter) {
+    if (!WaitBlocking(waiter)) return;
+    base::MutexGuard guard(channels_mutex.Pointer());
+    if (isolate->IsExecutionTerminating()) {
+      ReturnUndeliveredLocked(waiter.get());
+      return;
+    }
+    data = std::move(waiter->data);
+    index = waiter->index;
+    closed = waiter->closed;
+  }
+  Local<Object> result;
+  if (!MakeResult(isolate, context, index, closed, std::move(data))
+           .ToLocal(&result)) {
+    return;
+  }
+  if (blocking) {
+    info.GetReturnValue().Set(result);
+    return;
+  }
+  Local<Promise::Resolver> resolver =
+      Promise::Resolver::New(context).ToLocalChecked();
+  USE(resolver->Resolve(context, result));
+  info.GetReturnValue().Set(resolver->GetPromise());
+}
+
+// __recv(blocking)
+void ChannelRecv(const FunctionCallbackInfo<Value>& info) {
+  std::shared_ptr<ChannelState> state = ThisState(info);
+  if (!state) return;
+  Receive(info, {state}, info[0]->IsTrue());
+}
+
+// Channel.__select(channels, blocking)
+void ChannelSelect(const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  Local<Context> context = isolate->GetCurrentContext();
+  if (!info[0]->IsArray() || info[0].As<Array>()->Length() == 0) {
+    ThrowTypeError(isolate, "Channel.select() expects a non-empty array");
+    return;
+  }
+  Local<Array> array = info[0].As<Array>();
+  std::vector<std::shared_ptr<ChannelState>> states;
+  for (uint32_t i = 0; i < array->Length(); i++) {
+    Local<Value> element;
+    if (!array->Get(context, i).ToLocal(&element)) return;
+    std::shared_ptr<ChannelState> state = StateOf(isolate, element);
+    if (!state) {
+      ThrowTypeError(isolate, "Channel.select() expects channels");
+      return;
+    }
+    states.push_back(std::move(state));
+  }
+  Receive(info, std::move(states), info[1]->IsTrue());
+}
+
+void ChannelClose(const FunctionCallbackInfo<Value>& info) {
+  std::shared_ptr<ChannelState> state = ThisState(info);
+  if (!state) return;
+  bool was_closed;
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    was_closed = state->closed;
+    if (!was_closed) {
+      state->closed = true;
+      // Values already sent stay receivable; their senders are done.
+      PromoteLocked(state.get());
+      std::deque<ChannelState::Receiver> receivers =
+          std::move(state->receivers);
+      state->receivers.clear();
+      for (ChannelState::Receiver& receiver : receivers) {
+        if (receiver.waiter->done) continue;
+        receiver.waiter->closed = true;
+        receiver.waiter->index = receiver.index;
+        CompleteLocked(receiver.waiter);
+      }
+    }
+  }
+  if (was_closed) ThrowTypeError(info.GetIsolate(), "close of a closed channel");
+}
+
+void ChannelCapacity(const FunctionCallbackInfo<Value>& info) {
+  std::shared_ptr<ChannelState> state = ThisState(info);
+  if (!state) return;
+  info.GetReturnValue().Set(static_cast<double>(state->capacity));
+}
+
+void ChannelSize(const FunctionCallbackInfo<Value>& info) {
+  std::shared_ptr<ChannelState> state = ThisState(info);
+  if (!state) return;
+  size_t size;
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    size = state->accepted;
+  }
+  info.GetReturnValue().Set(static_cast<double>(size));
+}
+
+void ChannelClosed(const FunctionCallbackInfo<Value>& info) {
+  std::shared_ptr<ChannelState> state = ThisState(info);
+  if (!state) return;
+  bool closed;
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    closed = state->closed;
+  }
+  info.GetReturnValue().Set(closed);
+}
+
+}  // namespace
+
+// static
+Local<FunctionTemplate> Channels::CreateTemplate(Isolate* isolate) {
+  Local<FunctionTemplate> ctor = FunctionTemplate::New(isolate, ChannelNew);
+  ctor->SetClassName(String::NewFromUtf8Literal(isolate, "Channel"));
+  ctor->InstanceTemplate()->SetInternalFieldCount(1);
+  Local<Signature> signature = Signature::New(isolate, ctor);
+  for (auto [name, callback] :
+       {std::pair{"__send", ChannelSend}, std::pair{"__recv", ChannelRecv},
+        std::pair{"close", ChannelClose}}) {
+    ctor->PrototypeTemplate()->Set(
+        String::NewFromUtf8(isolate, name).ToLocalChecked(),
+        FunctionTemplate::New(isolate, callback, Local<Value>(), signature, 0,
+                              ConstructorBehavior::kThrow));
+  }
+  for (auto [name, callback] :
+       {std::pair{"capacity", ChannelCapacity}, std::pair{"size", ChannelSize},
+        std::pair{"closed", ChannelClosed}}) {
+    ctor->PrototypeTemplate()->SetAccessorProperty(
+        String::NewFromUtf8(isolate, name).ToLocalChecked(),
+        FunctionTemplate::New(isolate, callback, Local<Value>(), signature, 0,
+                              ConstructorBehavior::kThrow));
+  }
+  ctor->Set(isolate, "__select",
+            FunctionTemplate::New(isolate, ChannelSelect));
+  DataOf(isolate).ctor.Reset(isolate, ctor);
+  return ctor;
+}
+
+// static
+std::shared_ptr<ChannelState> Channels::FromValue(Isolate* isolate,
+                                                  Local<Value> value) {
+  IsolateChannels& data = DataOf(isolate);
+  if (data.ctor.IsEmpty() || !value->IsObject()) return nullptr;
+  if (!data.ctor.Get(isolate)->HasInstance(value)) return nullptr;
+  Local<Object> object = value.As<Object>();
+  if (object->InternalFieldCount() != 1) return nullptr;
+  Local<Data> field = object->GetInternalField(0);
+  if (!field->IsValue() || !field.As<Value>()->IsExternal()) return nullptr;
+  auto* handle = static_cast<ChannelHandle*>(
+      field.As<Value>().As<External>()->Value(kChannelTag));
+  return handle->state;
+}
+
+// static
+MaybeLocal<Object> Channels::ToObject(Isolate* isolate,
+                                      std::shared_ptr<ChannelState> state) {
+  IsolateChannels& data = DataOf(isolate);
+  if (data.ctor.IsEmpty()) return {};
+  Local<Object> object;
+  if (!data.ctor.Get(isolate)
+           ->InstanceTemplate()
+           ->NewInstance(isolate->GetCurrentContext())
+           .ToLocal(&object)) {
+    return {};
+  }
+  Attach(isolate, object, std::move(state));
+  return object;
+}
+
+// static
+void Channels::TerminateIsolate(Isolate* isolate) {
+  base::MutexGuard guard(channels_mutex.Pointer());
+  TerminatingIsolates().insert(isolate);
+  for (ChannelWaiter* waiter : BlockingWaiters()) {
+    if (waiter->isolate != isolate || waiter->cancelled) continue;
+    if (waiter->done) {
+      ReturnUndeliveredLocked(waiter);
+    } else {
+      CancelLocked(waiter);
+    }
+    waiter->cancelled = true;
+    waiter->ready.store(true, std::memory_order_release);
+    waiter->completed.Signal();
+  }
+}
+
+// static
+bool Channels::HasPendingWaits(Isolate* isolate) {
+  if (DataOf(isolate).pending.empty()) return false;
+  // A terminated isolate must be able to leave its event loop.
+  base::MutexGuard guard(channels_mutex.Pointer());
+  return !TerminatingIsolates().contains(isolate);
+}
+
+// static
+void Channels::ForgetIsolate(Isolate* isolate) {
+  IsolateChannels& data = DataOf(isolate);
+  {
+    base::MutexGuard guard(channels_mutex.Pointer());
+    TerminatingIsolates().erase(isolate);
+    for (auto& [id, pending] : data.pending) {
+      if (pending.waiter->done) {
+        ReturnUndeliveredLocked(pending.waiter.get());
+      } else {
+        CancelLocked(pending.waiter.get());
+      }
+    }
+  }
+  for (auto& [id, pending] : data.pending) {
+    pending.resolver.Reset();
+    pending.context.Reset();
+  }
+  data.pending.clear();
+  // Weak callbacks do not run when an isolate is disposed.
+  for (ChannelHandle* handle : data.handles) {
+    handle->object.Reset();
+    delete handle;
+  }
+  data.handles.clear();
+  data.ctor.Reset();
+  base::MutexGuard guard(isolates_mutex.Pointer());
+  AllData().erase(isolate);
+}
+
+}  // namespace v8
