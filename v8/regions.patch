+
+void Shell::RegionNew(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Isolate* isolate = info.GetIsolate();
+  if (!info.IsConstructCall()) {
+    ThrowError(isolate, "Region must be constructed with new");
+    return;
+  }
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  int region = i::RegionRegistry::Create(i_isolate);
+  if (region < 0) {
+    // Ids are released by the shared heap GC, which empty regions never
+    // trigger. Collect dead Region handles here, then the shared heap.
+    i_isolate->heap()->CollectAllGarbage(
+        i::GCFlag::kNoFlags, i::GarbageCollectionReason::kExternalMemoryPressure);
+    i_isolate->heap()->CollectGarbageShared(
+        i_isolate->main_thread_local_heap(),
+        i::GarbageCollectionReason::kExternalMemoryPressure);
+    region = i::RegionRegistry::Create(i_isolate);
+  }
+  if (region < 0) {
+    ThrowError(isolate, "Too many regions");
+    return;
+  }
+  info.This()->SetInternalField(0, Int32::New(isolate, region));
+  PerIsolateData::Get(isolate)->TrackRegionHandle(info.This(), region);
+}
+
+void Shell::RegionId(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  info.GetReturnValue().Set(RegionIdOf(info));
+}
