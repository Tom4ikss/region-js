+void Shell::RegionIsRegionObject(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  info.GetReturnValue().Set(
+      info.Length() > 0 &&
+      i::IsJSRegionObject(*Utils::OpenDirectHandle(*info[0])));
+}
+
+// Region.__info(value): -1 unless `value` is a region object, otherwise
+// id * 4 + state, where state is 0 if this isolate owns the region, 1 if it is
+// frozen, 2 if it is frozen and this isolate may thaw it, and 3 if this isolate
+// cannot access it. Used by the spawn() and channel code on every value, so it
+// creates no handles.
+void Shell::RegionInfo(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  if (info.Length() < 1) {
+    info.GetReturnValue().Set(-1);
+    return;
+  }
+  i::Tagged<i::Object> value = *Utils::OpenDirectHandle(*info[0]);
+  if (!i::IsJSRegionObject(value)) {
+    info.GetReturnValue().Set(-1);
+    return;
+  }
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(info.GetIsolate());
+  int region = i::Cast<i::JSRegionObject>(value)->region_id();
+  int state = i::RegionRegistry::IsOwner(region, i_isolate)       ? 0
+              : i::RegionRegistry::IsFrozenBy(region, i_isolate)  ? 2
+              : i::RegionRegistry::IsFrozen(region)               ? 1
+                                                                  : 3;
+  info.GetReturnValue().Set(region * 4 + state);
+}
