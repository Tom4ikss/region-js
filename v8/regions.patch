+#ifndef V8_D8_D8_PORT_H_
+#define V8_D8_D8_PORT_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "include/v8-local-handle.h"
+#include "include/v8-template.h"
+#include "src/d8/d8.h"
+#include "src/handles/shared-object-conveyor-handles.h"
+#include "src/objects/js-region.h"
+
+namespace v8 {
+
+// The shared state of a task port, see d8-port.cc.
+struct PortState;
+struct ChannelState;
+
+// A message: primitives and strings are copied, region objects are kept alive
+// by persistent handles of the shared space isolate (as a SharedValueConveyor
+// does), and the regions listed for transfer move with the message.
+struct PortMessage {
+  enum class Kind : uint8_t {
+    kUndefined,
+    kNull,
+    kTrue,
+    kFalse,
+    kNumber,
+    kString,
+    kShared,
+    kChannel,
+  };
+  struct Slot {
+    Kind kind;
+    double number;
+    uint32_t index;
+  };
+
+  ~PortMessage() {
