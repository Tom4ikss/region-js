+void AccessorAssembler::GotoIfRegionAccessDenied(TNode<HeapObject> object,
+                                                 bool for_write,
+                                                 Label* denied) {
+  // A plain load is enough: the owner synchronized when it claimed the region
+  // on this thread, and an isolate never sees a stale copy of its own address
+  // after releasing. Readers of a frozen region synchronize in Borrow() or
+  // when they receive the objects in a message; a reader without either may
+  // see a thaw late, but region objects have a fixed shape, so it can only
+  // read a stale value, never an invalid one.
+  TNode<Smi> region =
+      LoadObjectField<Smi>(object, offsetof(JSRegionObject, region_id_));
+  TNode<UintPtrT> owner = Load<UintPtrT>(
+      ExternalConstant(ExternalReference::region_registry_owners()),
+      TimesSystemPointerSize(SmiUntag(region)));
+  TNode<BoolT> is_owner = WordEqual(
+      owner, ReinterpretCast<UintPtrT>(
+                 ExternalConstant(ExternalReference::isolate_address())));
+  if (for_write) {
+    GotoIfNot(is_owner, denied);
+    return;
+  }
+  // A frozen region is readable by the isolate that froze it and by those
+  // that borrow it: they are marked in this isolate's read table.
+  Label allowed(this);
+  GotoIf(is_owner, &allowed);
+  GotoIfNot(WordEqual(owner, UintPtrConstant(RegionRegistry::kFrozen)), denied);
+  TNode<RawPtrT> table = Load<RawPtrT>(
+      ExternalConstant(ExternalReference::region_read_table_address(isolate())));
+  GotoIf(WordEqual(table, IntPtrConstant(0)), denied);
+  GotoIf(Word32Equal(Load<Uint8T>(table, SmiUntag(region)), Int32Constant(0)),
+         denied);
+  Goto(&allowed);
+  BIND(&allowed);
+}
