+Local<FunctionTemplate> Shell::CreateRegionTemplate(Isolate* isolate) {
+  Local<FunctionTemplate> region_template =
+      FunctionTemplate::New(isolate, RegionNew);
+  Local<Signature> signature = Signature::New(isolate, region_template);
+  region_template->SetClassName(String::NewFromUtf8Literal(isolate, "Region"));
+  region_template->ReadOnlyPrototype();
+  region_template->PrototypeTemplate()->SetAccessorProperty(
+      String::NewFromUtf8Literal(isolate, "id"),
+      FunctionTemplate::New(isolate, RegionId, Local<Value>(), signature, 0,
+                            ConstructorBehavior::kThrow));
+  region_template->PrototypeTemplate()->SetAccessorProperty(
+      String::NewFromUtf8Literal(isolate, "owner"),
+      FunctionTemplate::New(isolate, RegionOwner, Local<Value>(), signature, 0,
+                            ConstructorBehavior::kThrow));
+  region_template->PrototypeTemplate()->Set(
+      isolate, "run",
+      FunctionTemplate::New(isolate, RegionRun, Local<Value>(), signature, 1,
+                            ConstructorBehavior::kThrow));
+  region_template->Set(isolate, "of", FunctionTemplate::New(isolate, RegionOf));
+  region_template->Set(isolate, "isRegionObject",
+                       FunctionTemplate::New(isolate, RegionIsRegionObject));
+  region_template->Set(isolate, "__info",
+                       FunctionTemplate::New(isolate, RegionInfo));
+  region_template->Set(isolate, "object",
+                       FunctionTemplate::New(isolate, RegionCurrentObject));
+  region_template->Set(isolate, "array",
+                       FunctionTemplate::New(isolate, RegionCurrentArray));
+  {
+    // Scopes returned by region.enter(): [region id or undefined].
+    Local<FunctionTemplate> scope_template = FunctionTemplate::New(isolate);
+    scope_template->SetClassName(
+        String::NewFromUtf8Literal(isolate, "RegionScope"));
+    scope_template->InstanceTemplate()->SetInternalFieldCount(1);
+    Local<FunctionTemplate> exit = FunctionTemplate::New(
+        isolate, RegionScopeExit, Local<Value>(),
+        Signature::New(isolate, scope_template), 0, ConstructorBehavior::kThrow);
+    scope_template->PrototypeTemplate()->Set(
+        Utils::ToLocal(reinterpret_cast<i::Isolate*>(isolate)
+                           ->factory()
+                           ->dispose_symbol()),
+        exit);
+    scope_template->PrototypeTemplate()->Set(
+        String::NewFromUtf8Literal(isolate, "exit"), exit);
+    PerIsolateData::Get(isolate)->region_scope_ctor_.Reset(isolate,
+                                                           scope_template);
+  }
+  region_template->Set(isolate, "stats",
+                       FunctionTemplate::New(isolate, RegionStats));
+  // `using region = new Region()` frees the region at the end of the block,
+  // unless it has moved away by then.
+  region_template->PrototypeTemplate()->Set(
