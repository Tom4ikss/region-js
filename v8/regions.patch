+namespace v8 {
+namespace internal {
+
+// Process-wide table of ownership regions. A region is in one of four states:
+//   Owned(isolate)         - only the owner may read and write;
+//   InTransit              - nobody may access it;
+//   Frozen(owner, readers) - every isolate may read, nobody may write, and the
+//                            owner may thaw it once no borrows are left;
+//   Freed                  - nobody may access it ever again; its objects are
+//                            emptied at the next shared GC.
+class V8_EXPORT_PRIVATE RegionRegistry {
+ public:
+  static constexpr int kMaxRegions = 1 << 20;
+  static constexpr int kInTransit = -1;
+  // Values of the owners table entry while a region is frozen or freed.
+  static constexpr uintptr_t kFrozen = 1;
+  static constexpr uintptr_t kFreed = 2;
+  static constexpr int kFreedOwner = -2;
+
+  // Returns the new region id, or -1 if the table is full. Ids of released
+  // regions are reused.
+  static int Create(Isolate* owner);
+  // Whether isolate may write, i.e. owns the region and it is not frozen.
+  static bool IsOwner(int region, Isolate* isolate);
+  static bool CanRead(int region, Isolate* isolate);
+  static bool IsFrozen(int region);
+  static bool IsInTransit(int region);
+  static bool IsFreed(int region);
+
+  // Owned(isolate) -> Freed, or Frozen(isolate, 0) -> Freed.
+  enum class FreeResult { kFreed, kNotOwner, kBorrowed };
+  static FreeResult Free(int region, Isolate* isolate);
+
+  // Bytes copied into the region by region.run() and spawn(), roughly: its
+  // objects, their arrays, strings and typed array buffers.
+  static size_t Bytes(int region);
+  static void AddBytes(int region, size_t bytes);
+  struct Stats {
+    int regions;
+    int freed;
+    size_t bytes;
+  };
+  static Stats GetStats();
+  // Id of the owning isolate, also while frozen; kInTransit while moving.
+  static int Owner(int region);
+  static int Readers(int region);
+
+  // Owned(isolate) -> InTransit. Fails if isolate is not the owner.
+  static bool Release(int region, Isolate* isolate);
+  // InTransit -> Owned(isolate). Fails if the region is not in transit or the
+  // id was reused since `generation`.
+  static bool Claim(int region, int generation, Isolate* isolate);
+  // Incremented every time the id of a released region is reused.
+  static int Generation(int region);
+
+  // JS handles to a region (d8 Region objects). A region with handles is never
+  // released.
+  static void AddHandle(int region);
+  static void RemoveHandle(int region);
+
+  // Releases regions that have neither live objects nor handles, so that their
+  // ids can be reused. Called by the shared space isolate after a full GC,
+  // while all isolates are stopped.
+  static void ReleaseUnusedRegions(Heap* shared_space_heap);
+
+  // Owned(isolate) -> Frozen(isolate, 0).
+  static bool Freeze(int region, Isolate* isolate);
+  enum class ThawResult { kThawed, kNotFrozenByIsolate, kBorrowed };
+  // Frozen(isolate, 0) -> Owned(isolate).
+  static ThawResult Thaw(int region, Isolate* isolate);
+  static bool IsFrozenBy(int region, Isolate* isolate);
+  // The right to thaw a frozen region can be sent to another isolate:
+  // Frozen(isolate, n) -> Frozen(in transit, n) -> Frozen(receiver, n).
+  static bool ReleaseFreeze(int region, Isolate* isolate);
+  static bool ClaimFreeze(int region, int generation, Isolate* isolate);
+  // Frozen(owner, n) -> Frozen(owner, n + 1). Fails unless frozen. Borrows
+  // are also counted per isolate: typed array views of a frozen region are
+  // handed out only to the isolate that froze it and to isolates borrowing
+  // it, and are detached once the isolate is neither.
+  static bool Borrow(int region, Isolate* isolate);
+  static void Unborrow(int region, Isolate* isolate);
+  static bool IsBorrowedBy(int region, Isolate* isolate);
+  // Marks whether `isolate` may read frozen `region`, in its read table.
+  static void SetReadable(int region, Isolate* isolate, bool readable);
+  static void ForgetReadTable(Isolate* isolate);
+
+  // Table indexed by region id, read by generated code. Holds the Isolate* of
+  // the owner, 0 while the region is in transit, or kFrozen.
+  static Address owners_address() {
+    return reinterpret_cast<Address>(&owners_[0]);
+  }
+
+ private:
+  static constexpr int kNotFrozen = -1;
+
+  static std::atomic<int> next_region_;
+  static std::atomic<uintptr_t> owners_[kMaxRegions];
+  // Isolate ids for error messages; follows owners_.
+  static std::atomic<int> owner_ids_[kMaxRegions];
+  // Isolate allowed to thaw a frozen region.
+  static std::atomic<uintptr_t> frozen_by_[kMaxRegions];
+  // Number of borrows of a frozen region, kNotFrozen otherwise.
+  static std::atomic<int> readers_[kMaxRegions];
+  static std::atomic<int> generations_[kMaxRegions];
+  static std::atomic<int> handles_[kMaxRegions];
+  static std::atomic<bool> in_use_[kMaxRegions];
+  static std::atomic<size_t> bytes_[kMaxRegions];
+};
+
+// A plain object or array copied into an ownership region. Properties are not
+// described by the map: an object keeps parallel `keys` and `values` arrays,
+// an array keeps only `values` and has undefined `keys`.
+V8_OBJECT class JSRegionObject : public JSSpecialObject {
+  V8_IT_OWN_TYPE;
+
+ public:
+  inline int region_id() const;
+  inline void set_region_id(int value);
+
+  inline Tagged<Union<FixedArray, Undefined>> keys() const;
+  inline void set_keys(Tagged<Union<FixedArray, Undefined>> value,
+                       WriteBarrierMode mode = UPDATE_WRITE_BARRIER);
+
+  inline Tagged<FixedArray> values() const;
+  inline void set_values(Tagged<FixedArray> value,
+                         WriteBarrierMode mode = UPDATE_WRITE_BARRIER);
+
+  inline bool is_array() const;
+  // Length of an array; values() can be longer, so that arrays can grow.
+  inline uint32_t array_length() const;
+  inline void set_array_length(uint32_t value);
+  // Makes room for `capacity` elements, keeping the first array_length().
+  static void EnsureArrayCapacity(Isolate* isolate,
+                                  DirectHandle<JSRegionObject> array,
+                                  uint32_t capacity);
+  static Maybe<bool> DeleteProperty(LookupIterator* it);
+
+  // Copies the graph reachable from `value` into `region` and returns the
+  // copy. Primitives are shared, region objects of the same region are kept.
+  // Typed arrays are copied, except those whose ArrayBuffer is in `transfer`
+  // (or all of them if `transfer_all`): their bytes move into the region and
+  // the buffers are detached.
+  static MaybeDirectHandle<Object> Evacuate(
+      Isolate* isolate, int region, DirectHandle<Object> value,
+      DirectHandleVector<JSArrayBuffer>* transfer = nullptr,
+      bool transfer_all = false);
+
+  // Property access while a LookupIterator is in the REGION_OBJECT state.
+  // All of them except GetDataProperty throw unless the current isolate owns
+  // the holder's region.
+  static MaybeHandle<Object> GetProperty(LookupIterator* it);
+  static Handle<Object> GetDataProperty(LookupIterator* it);
+  static Maybe<bool> HasProperty(LookupIterator* it);
+  static Maybe<PropertyAttributes> GetPropertyAttributes(LookupIterator* it);
+  static Maybe<bool> SetProperty(LookupIterator* it, DirectHandle<Object> value,
+                                 Maybe<ShouldThrow> should_throw);
+
+  // For inline caches: index of the named property in values(),
+  // kArrayLengthIndex for `length` of an array, or kNotFound when the access
+  // must stay on the slow path. Never throws.
+  static constexpr int kNotFound = -1;
+  static constexpr int kArrayLengthIndex = -2;
+  static int LookupIndexForIC(LookupIterator* it);
+
+  // Throws and returns false unless the current isolate may read `object`.
+  static bool CheckReadAccess(Isolate* isolate,
+                              DirectHandle<JSRegionObject> object);
+
+  // Turns a value read from a region into what JS sees: a typed array in the
+  // region becomes a local typed array view of its bytes, any other value is
+  // returned as is. The owner gets a writable view; readers of a frozen
+  // region get an immutable one, and only while they borrow it: a view must
+  // not outlive the right to read.
+  static MaybeHandle<Object> ToJSValue(Isolate* isolate, Handle<Object> value);
+
+  // Detaches the typed array views of `region` created in `isolate`. Called
+  // before the isolate gives up access: on move, freeze and thaw, and when it
+  // stops borrowing a frozen region.
+  static void DetachViews(Isolate* isolate, int region);
+  // Detaches the views of a frozen region unless `isolate` may still read
+  // them: it froze the region or borrows it.
+  static void DetachFrozenViewsIfUnused(Isolate* isolate, int region);
+  // Drops the typed array memory of a freed region right away.
+  static void ReleaseBackingStores(int region);
+  // Drops the view bookkeeping of an isolate that is being torn down.
+  static void ForgetIsolate(Isolate* isolate);
+
+  // The current region of an isolate: region.enter() and region.run() push
+  // it, #{} and #[] create their objects in the innermost one. -1 if none.
+  static void PushCurrent(Isolate* isolate, int region);
+  static void PopCurrent(Isolate* isolate, int region);
