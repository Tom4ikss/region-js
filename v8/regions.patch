+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef V8_D8_D8_CHANNEL_H_
+#define V8_D8_D8_CHANNEL_H_
+
+#include <memory>
+
+#include "include/v8-local-handle.h"
+#include "include/v8-template.h"
+
+namespace v8 {
+
+// The shared state of a channel, see d8-channel.cc.
+struct ChannelState;
+
+// Channels between isolates for the ownership regions prototype: a value sent
+// into a channel is serialized like a postMessage() message, so region
+// objects move with it, and is deserialized by the isolate that receives it.
+class Channels {
+ public:
+  static Local<FunctionTemplate> CreateTemplate(Isolate* isolate);
+
+  // Serializer support: the state behind a Channel object, or null if
+  // `value` is not one, and a Channel object for a received state.
+  static std::shared_ptr<ChannelState> FromValue(Isolate* isolate,
+                                                 Local<Value> value);
+  static MaybeLocal<Object> ToObject(Isolate* isolate,
+                                     std::shared_ptr<ChannelState> state);
+
+  // Whether the isolate waits for a send or receive to complete; that keeps
+  // its event loop running.
+  static bool HasPendingWaits(Isolate* isolate);
+  // Called when an isolate is asked to terminate: its blocked channel
+  // operations return, and values no longer go to it.
+  static void TerminateIsolate(Isolate* isolate);
+  // Cancels the pending operations of an isolate that is being disposed.
+  static void ForgetIsolate(Isolate* isolate);
+};
+
+}  // namespace v8
+
+#endif  // V8_D8_D8_CHANNEL_H_
