+
+int RegionRegistry::Create(Isolate* owner) {
+  int region;
+  {
+    base::MutexGuard guard(RegionsMutex());
+    if (!FreeRegions()->empty()) {
+      region = FreeRegions()->back();
+      FreeRegions()->pop_back();
+    } else {
+      region = next_region_.load(std::memory_order_relaxed);
+      if (region >= kMaxRegions) return -1;
+      next_region_.store(region + 1, std::memory_order_relaxed);
+    }
+  }
+  in_use_[region].store(true, std::memory_order_relaxed);
+  handles_[region].store(0, std::memory_order_relaxed);
+  bytes_[region].store(0, std::memory_order_relaxed);
+  owner_ids_[region].store(owner->id(), std::memory_order_relaxed);
+  readers_[region].store(kNotFrozen, std::memory_order_relaxed);
+  owners_[region].store(OwnerKey(owner), std::memory_order_release);
+  return region;
+}
+
+int RegionRegistry::Owner(int region) {
+  DCHECK(0 <= region && region < kMaxRegions);
+  return owner_ids_[region].load(std::memory_order_relaxed);
+}
+
+int RegionRegistry::Readers(int region) {
+  return std::max(readers_[region].load(std::memory_order_acquire), 0);
+}
+
+bool RegionRegistry::IsOwner(int region, Isolate* isolate) {
+  DCHECK(0 <= region && region < kMaxRegions);
+  return owners_[region].load(std::memory_order_acquire) == OwnerKey(isolate);
+}
+
+// A frozen region needs a borrow, or to have been frozen by this isolate:
+// a reader without one could see a thaw in the middle of a read.
+bool RegionRegistry::CanRead(int region, Isolate* isolate) {
+  uintptr_t owner = owners_[region].load(std::memory_order_acquire);
+  if (owner == OwnerKey(isolate)) return true;
+  if (owner != kFrozen) return false;
+  uint8_t* table = isolate->region_read_table();
+  return table && table[region];
+}
+
+namespace {
+
+// Every read table, so that a released region id can be cleared in all.
+base::Mutex* ReadTablesMutex() {
+  static base::LeakyObject<base::Mutex> mutex;
+  return mutex.get();
+}
+std::vector<uint8_t*>* ReadTables() {
+  static base::LeakyObject<std::vector<uint8_t*>> tables;
+  return tables.get();
+}
+
+}  // namespace
+
+// static
+void RegionRegistry::SetReadable(int region, Isolate* isolate, bool readable) {
+  uint8_t* table = isolate->region_read_table();
+  if (!table) {
+    if (!readable) return;
+    table = static_cast<uint8_t*>(base::Calloc(kMaxRegions, 1));
+    CHECK_NOT_NULL(table);
+    isolate->set_region_read_table(table);
+    base::MutexGuard guard(ReadTablesMutex());
+    ReadTables()->push_back(table);
+  }
+  table[region] = readable ? 1 : 0;
+}
+
+// static
+void RegionRegistry::ForgetReadTable(Isolate* isolate) {
+  uint8_t* table = isolate->region_read_table();
+  if (!table) return;
+  {
+    base::MutexGuard guard(ReadTablesMutex());
+    std::erase(*ReadTables(), table);
+  }
+  isolate->set_region_read_table(nullptr);
+  base::Free(table);
+}
+
+bool RegionRegistry::IsFrozen(int region) {
+  return owners_[region].load(std::memory_order_acquire) == kFrozen;
+}
+
+bool RegionRegistry::IsInTransit(int region) {
+  return owners_[region].load(std::memory_order_acquire) == 0;
+}
+
+bool RegionRegistry::IsFreed(int region) {
+  return owners_[region].load(std::memory_order_acquire) == kFreed;
+}
+
+RegionRegistry::FreeResult RegionRegistry::Free(int region, Isolate* isolate) {
+  uintptr_t expected = OwnerKey(isolate);
+  if (!owners_[region].compare_exchange_strong(expected, kFreed,
+                                               std::memory_order_acq_rel)) {
+    if (!IsFrozenBy(region, isolate)) return FreeResult::kNotOwner;
+    // As in Thaw(): closing the counter makes later borrows fail.
+    int readers = 0;
+    if (!readers_[region].compare_exchange_strong(readers, kNotFrozen,
+                                                  std::memory_order_acq_rel)) {
+      return FreeResult::kBorrowed;
+    }
+    frozen_by_[region].store(0, std::memory_order_relaxed);
+    owners_[region].store(kFreed, std::memory_order_release);
+  }
+  owner_ids_[region].store(kFreedOwner, std::memory_order_relaxed);
+  bytes_[region].store(0, std::memory_order_relaxed);
+  SetReadable(region, isolate, false);
+  return FreeResult::kFreed;
+}
+
+size_t RegionRegistry::Bytes(int region) {
+  return bytes_[region].load(std::memory_order_relaxed);
+}
+
+void RegionRegistry::AddBytes(int region, size_t bytes) {
+  bytes_[region].fetch_add(bytes, std::memory_order_relaxed);
+}
+
+RegionRegistry::Stats RegionRegistry::GetStats() {
+  Stats stats{0, 0, 0};
+  int count = next_region_.load(std::memory_order_relaxed);
+  for (int region = 0; region < count; region++) {
+    if (!in_use_[region].load(std::memory_order_relaxed)) continue;
+    if (IsFreed(region)) {
+      stats.freed++;
+    } else {
+      stats.regions++;
+      stats.bytes += Bytes(region);
+    }
+  }
+  return stats;
+}
+
+bool RegionRegistry::Release(int region, Isolate* isolate) {
+  uintptr_t expected = OwnerKey(isolate);
+  if (!owners_[region].compare_exchange_strong(expected, 0,
+                                               std::memory_order_acq_rel)) {
+    return false;
+  }
+  owner_ids_[region].store(kInTransit, std::memory_order_relaxed);
+  return true;
+}
+
+int RegionRegistry::Generation(int region) {
+  return generations_[region].load(std::memory_order_acquire);
+}
+
+void RegionRegistry::AddHandle(int region) {
+  handles_[region].fetch_add(1, std::memory_order_relaxed);
+}
+
+void RegionRegistry::RemoveHandle(int region) {
+  int previous = handles_[region].fetch_sub(1, std::memory_order_relaxed);
+  CHECK_GT(previous, 0);
+}
+
+bool RegionRegistry::Claim(int region, int generation, Isolate* isolate) {
+  if (Generation(region) != generation) return false;
+  uintptr_t expected = 0;
+  if (!owners_[region].compare_exchange_strong(expected, OwnerKey(isolate),
+                                               std::memory_order_acq_rel)) {
+    return false;
+  }
+  owner_ids_[region].store(isolate->id(), std::memory_order_relaxed);
+  return true;
+}
+
+bool RegionRegistry::Freeze(int region, Isolate* isolate) {
+  if (!IsOwner(region, isolate)) return false;
+  frozen_by_[region].store(OwnerKey(isolate), std::memory_order_relaxed);
+  // Borrows only succeed once the owners entry says kFrozen, so the counter
+  // can be reset before publishing the new state.
+  readers_[region].store(0, std::memory_order_relaxed);
+  // The isolate that freezes keeps reading without a borrow.
+  SetReadable(region, isolate, true);
+  uintptr_t expected = OwnerKey(isolate);
+  if (!owners_[region].compare_exchange_strong(expected, kFrozen,
+                                               std::memory_order_acq_rel)) {
+    readers_[region].store(kNotFrozen, std::memory_order_relaxed);
+    SetReadable(region, isolate, false);
+    return false;
+  }
+  return true;
+}
+
+RegionRegistry::ThawResult RegionRegistry::Thaw(int region, Isolate* isolate) {
+  if (!IsFrozen(region) ||
+      frozen_by_[region].load(std::memory_order_relaxed) != OwnerKey(isolate)) {
+    return ThawResult::kNotFrozenByIsolate;
+  }
+  // Closing the counter makes every later Borrow fail, so no reader can start
+  // between this check and the owner getting write access back.
+  int expected = 0;
+  if (!readers_[region].compare_exchange_strong(expected, kNotFrozen,
+                                                std::memory_order_acq_rel)) {
+    return ThawResult::kBorrowed;
+  }
+  owners_[region].store(OwnerKey(isolate), std::memory_order_release);
+  SetReadable(region, isolate, false);
+  return ThawResult::kThawed;
+}
+
+void RegionRegistry::ReleaseUnusedRegions(Heap* heap) {
+  DCHECK(heap->isolate()->is_shared_space_isolate());
+  int count = next_region_.load(std::memory_order_relaxed);
+  if (count == 0) return;
+
+  // An id may only be reused once no object of its region is left: otherwise
+  // the next owner of the id could reach stale objects.
+  std::vector<bool> live(count);
+  std::vector<bool> live_stores(RegionBackingStores::Count());
+  heap->CompleteSweepingFull(CompleteSweepingReason::kHeapObjectIterator);
+  PagedSpaceObjectIterator iterator(heap, heap->shared_space());
+  for (Tagged<HeapObject> object = iterator.Next(); !object.is_null();
+       object = iterator.Next()) {
+    if (!IsJSRegionObject(object)) continue;
+    int region = Cast<JSRegionObject>(object)->region_id();
+    live[region] = true;
+    if (IsFreed(region)) {
+      // Nobody may read a freed region, so its objects can let go of what
+      // they hold; the next GC collects it even if JS still refers to them.
+      Tagged<JSRegionObject> freed = Cast<JSRegionObject>(object);
+      Tagged<FixedArray> empty = ReadOnlyRoots(heap->isolate()).empty_fixed_array();
+      if (!freed->is_array()) freed->set_keys(empty, SKIP_WRITE_BARRIER);
+      freed->set_values(empty, SKIP_WRITE_BARRIER);
+      freed->set_array_length(0);
+      if (IsJSRegionTypedArray(object)) {
+        Tagged<JSRegionTypedArray> holder = Cast<JSRegionTypedArray>(object);
+        holder->Initialize(-1, holder->element_type(), Smi::zero(), Smi::zero());
+      }
+      continue;
+    }
+    if (IsJSRegionTypedArray(object)) {
+      int store = Cast<JSRegionTypedArray>(object)->backing_store_id();
+      if (store >= 0) live_stores[store] = true;
+    }
+  }
+  RegionBackingStores::ReleaseUnused(live_stores);
+
+  base::MutexGuard guard(RegionsMutex());
+  for (int region = 0; region < count; region++) {
+    if (!in_use_[region].load(std::memory_order_relaxed) || live[region] ||
+        handles_[region].load(std::memory_order_relaxed) > 0 ||
+        readers_[region].load(std::memory_order_relaxed) > 0) {
+      continue;
+    }
+    // All isolates are stopped: no read table is in use.
+    {
+      base::MutexGuard tables_guard(ReadTablesMutex());
+      for (uint8_t* table : *ReadTables()) table[region] = 0;
+    }
+    in_use_[region].store(false, std::memory_order_relaxed);
+    generations_[region].fetch_add(1, std::memory_order_release);
+    owners_[region].store(0, std::memory_order_release);
+    owner_ids_[region].store(kInTransit, std::memory_order_relaxed);
+    readers_[region].store(kNotFrozen, std::memory_order_relaxed);
+    bytes_[region].store(0, std::memory_order_relaxed);
+    FreeRegions()->push_back(region);
+  }
+}
+
+bool RegionRegistry::IsFrozenBy(int region, Isolate* isolate) {
+  return IsFrozen(region) &&
+         frozen_by_[region].load(std::memory_order_acquire) == OwnerKey(isolate);
+}
+
+bool RegionRegistry::ReleaseFreeze(int region, Isolate* isolate) {
+  if (!IsFrozen(region)) return false;
+  uintptr_t expected = OwnerKey(isolate);
+  if (!frozen_by_[region].compare_exchange_strong(expected, 0,
+                                                   std::memory_order_acq_rel)) {
+    return false;
+  }
+  owner_ids_[region].store(kInTransit, std::memory_order_relaxed);
+  if (!IsBorrowedBy(region, isolate)) SetReadable(region, isolate, false);
+  return true;
+}
+
+bool RegionRegistry::ClaimFreeze(int region, int generation, Isolate* isolate) {
+  if (Generation(region) != generation || !IsFrozen(region)) return false;
+  uintptr_t expected = 0;
+  if (!frozen_by_[region].compare_exchange_strong(expected, OwnerKey(isolate),
+                                                   std::memory_order_acq_rel)) {
+    return false;
+  }
+  owner_ids_[region].store(isolate->id(), std::memory_order_relaxed);
+  SetReadable(region, isolate, true);
+  return true;
+}
+
+bool RegionRegistry::Borrow(int region, Isolate* isolate) {
+  int readers = readers_[region].load(std::memory_order_acquire);
+  while (readers >= 0) {
+    if (!IsFrozen(region)) return false;
+    if (readers_[region].compare_exchange_weak(readers, readers + 1,
+                                               std::memory_order_acq_rel)) {
+      RegionViews::ChangeBorrows(isolate, region, 1);
+      SetReadable(region, isolate, true);
+      return true;
+    }
+  }
+  return false;
+}
+
+void RegionRegistry::Unborrow(int region, Isolate* isolate) {
+  // Views go first: once the counter drops, the region may be thawed.
+  if (RegionViews::ChangeBorrows(isolate, region, -1) == 0) {
+    JSRegionObject::DetachFrozenViewsIfUnused(isolate, region);
+    if (!IsFrozenBy(region, isolate)) SetReadable(region, isolate, false);
+  }
+  int previous = readers_[region].fetch_sub(1, std::memory_order_acq_rel);
+  CHECK_GT(previous, 0);
+}
+
+bool RegionRegistry::IsBorrowedBy(int region, Isolate* isolate) {
+  return RegionViews::HasBorrow(isolate, region);
+}
+
+namespace {
+
+int LengthOf(Tagged<FixedArray> array) {
+  return static_cast<int>(array->ulength().value());
+}
+
+enum class Access { kRead, kWrite };
+
+void ThrowAccessError(Isolate* isolate, int region, Access access) {
+  Factory* factory = isolate->factory();
+  DirectHandle<Object> id = factory->NewNumberFromInt(region);
+  if (RegionRegistry::IsFreed(region)) {
+    isolate->Throw(*factory->NewTypeError(MessageTemplate::kRegionFreed, id));
+  } else if (RegionRegistry::IsInTransit(region)) {
+    isolate->Throw(
+        *factory->NewTypeError(MessageTemplate::kRegionInTransit, id));
+  } else if (access == Access::kWrite && RegionRegistry::IsFrozen(region)) {
+    isolate->Throw(*factory->NewTypeError(MessageTemplate::kRegionFrozen, id));
+  } else if (RegionRegistry::IsFrozen(region)) {
+    isolate->Throw(
+        *factory->NewTypeError(MessageTemplate::kRegionBorrowRequired, id));
+  } else {
+    isolate->Throw(*factory->NewTypeError(
+        MessageTemplate::kRegionNotOwner, id,
+        factory->NewNumberFromInt(RegionRegistry::Owner(region)),
+        factory->NewNumberFromInt(isolate->id())));
+  }
+}
+
+bool CanAccess(Isolate* isolate, int region, Access access) {
+  return access == Access::kRead ? RegionRegistry::CanRead(region, isolate)
+                                 : RegionRegistry::IsOwner(region, isolate);
+}
+
+// Throws and returns false unless the current isolate may access the region.
+bool CheckAccess(Isolate* isolate, Tagged<JSRegionObject> object,
+                 Access access) {
+  if (CanAccess(isolate, object->region_id(), access)) return true;
+  ThrowAccessError(isolate, object->region_id(), access);
+  return false;
+}
+
+bool IsArrayLength(Isolate* isolate, Tagged<JSRegionObject> object,
+                   LookupIterator* it) {
+  return object->is_array() && !it->IsElement() &&
+         *it->GetName() == ReadOnlyRoots(isolate).length_string();
+}
+
+// Returns the index of the looked up property in values(), or -1.
+int FindIndex(DirectHandle<JSRegionObject> object, LookupIterator* it) {
+  if (object->is_array()) {
+    if (!it->IsElement()) return -1;
+    size_t index = it->index();
+    return index < object->array_length() ? static_cast<int>(index) : -1;
+  }
+  DirectHandle<Name> name = it->GetName();
+  if (!IsString(*name)) return -1;
+  DisallowGarbageCollection no_gc;
+  Tagged<String> wanted = Cast<String>(*name);
+  Tagged<FixedArray> keys = Cast<FixedArray>(object->keys());
+  for (int i = 0; i < LengthOf(keys); i++) {
+    if (Cast<String>(keys->get(i))->Equals(wanted)) return i;
+  }
+  return -1;
+}
+
+MaybeHandle<Object> ReadOwnedProperty(Isolate* isolate,
+                                      DirectHandle<JSRegionObject> object,
+                                      LookupIterator* it) {
+  if (IsArrayLength(isolate, *object, it)) {
+    return handle(Smi::FromInt(static_cast<int>(object->array_length())),
+                  isolate);
+  }
+  int index = FindIndex(object, it);
+  if (index < 0) return isolate->factory()->undefined_value();
+  // Load values() once and check the index against it: a reader of a frozen
+  // region racing with a thaw and a push may see a length newer than the
+  // values() it loads.
+  Tagged<FixedArray> values = object->values();
+  if (static_cast<uint32_t>(index) >= values->ulength().value()) {
+    return isolate->factory()->undefined_value();
+  }
+  return JSRegionObject::ToJSValue(isolate, handle(values->get(index), isolate));
+}
+
+// Region objects have no prototype of their own, so properties missing from
+// them are looked up on Array.prototype or Object.prototype of the reading
+// isolate. That provides iteration and the generic array methods.
+LookupIterator PrototypeLookup(Isolate* isolate,
+                               DirectHandle<JSRegionObject> object,
+                               LookupIterator* it) {
+  DirectHandle<JSObject> prototype = object->is_array()
+                                         ? isolate->initial_array_prototype()
+                                         : isolate->initial_object_prototype();
+  if (it->IsElement()) {
+    return LookupIterator(isolate, it->GetReceiver(), it->index(), prototype);
+  }
+  return LookupIterator(isolate, it->GetReceiver(), it->GetName(), prototype);
+}
+
+DirectHandle<Map> NewRegionMapFor(Isolate* isolate, InstanceType type,
+                                  int instance_size) {
+  DirectHandle<Map> map = isolate->factory()->NewContextlessMap(
+      type, instance_size, DICTIONARY_ELEMENTS, 0, AllocationType::kSharedMap);
+  DisallowGarbageCollection no_gc;
+  map->SetInObjectUnusedPropertyFields(0);
+  map->set_is_extensible(false);
+  map->set_prototype_validity_cell(Map::kNoValidityCellSentinel, kRelaxedStore,
+                                   SKIP_WRITE_BARRIER);
+  return map;
+}
+
+// Per-isolate state of region literals: the stack of current regions and the
+// shapes of #{} literals, so that every literal with the same keys gets the
+// same map and inline caches stay monomorphic.
+class RegionLiterals {
+ public:
+  struct Shape {
+    Address* keys;  // Global handles of this isolate.
+    Address* map;
+  };
+  struct State {
+    std::vector<int> current;
+    std::unordered_map<uint32_t, std::vector<Shape>> shapes;
+    // The shapes used last, checked first by comparing key pointers: keys
+    // come from the constant pool, so a literal passes the same strings.
+    static constexpr int kRecent = 8;
+    Shape recent[kRecent] = {};
+    int next_recent = 0;
+    Address* array_map = nullptr;
+  };
+
+  // The entry of an isolate never moves, and an isolate runs on one thread
+  // at a time, so the last one looked up on this thread is remembered.
+  static State& Of(Isolate* isolate) {
+    thread_local Isolate* cached_isolate = nullptr;
+    thread_local State* cached_state = nullptr;
+    if (cached_isolate == isolate) return *cached_state;
+    base::MutexGuard guard(Mutex());
+    cached_isolate = isolate;
+    cached_state = &(*All())[isolate];
+    return *cached_state;
+  }
+
+  static void Forget(Isolate* isolate) {
+    base::MutexGuard guard(Mutex());
+    auto it = All()->find(isolate);
+    if (it == All()->end()) return;
+    for (auto& [hash, shapes] : it->second.shapes) {
+      for (Shape& shape : shapes) {
+        GlobalHandles::Destroy(shape.keys);
+        GlobalHandles::Destroy(shape.map);
+      }
+    }
+    if (it->second.array_map) GlobalHandles::Destroy(it->second.array_map);
+    // Keep the entry: a thread may still have it cached, and a new isolate
+    // at the same address starts from an empty state.
+    it->second = State();
+  }
+
+
+  // The keys array and map for objects with `keys`, shared by every object
+  // with these keys that this isolate creates in a region: by run(),
+  // Region.object() and #{}. One map per shape keeps inline caches
+  // monomorphic.
+  static std::pair<DirectHandle<FixedArray>, DirectHandle<Map>> ShapeFor(
+      Isolate* isolate, const DirectHandleVector<String>& keys) {
+    State& state = Of(isolate);
+    int length = static_cast<int>(keys.size());
+    for (const Shape& shape : state.recent) {
+      if (!shape.keys) continue;
+      Tagged<FixedArray> known = Cast<FixedArray>(Tagged<Object>(*shape.keys));
+      if (static_cast<int>(known->ulength().value()) != length) continue;
+      bool same = true;
+      for (int i = 0; i < length && same; i++) same = known->get(i) == *keys[i];
+      if (same) return Unpack(isolate, shape);
+    }
+    uint32_t hash = static_cast<uint32_t>(length);
+    for (DirectHandle<String> key : keys) hash = hash * 31 + key->EnsureHash();
+    std::vector<Shape>& candidates = state.shapes[hash];
+    for (const Shape& shape : candidates) {
+      Tagged<FixedArray> known = Cast<FixedArray>(Tagged<Object>(*shape.keys));
+      if (static_cast<int>(known->ulength().value()) != length) continue;
+      bool same = true;
+      for (int i = 0; i < length && same; i++) {
+        same = Cast<String>(known->get(i))->Equals(*keys[i]);
+      }
+      if (same) {
+        Remember(state, shape);
+        return Unpack(isolate, shape);
+      }
+    }
+    Factory* factory = isolate->factory();
+    DirectHandle<FixedArray> new_keys =
+        factory->NewFixedArray(length, AllocationType::kSharedOld);
+    for (int i = 0; i < length; i++) {
+      DirectHandle<String> key = String::Share(isolate, keys[i]);
+      // Shared strings must be hashed before other isolates can see them.
+      key->EnsureHash();
+      new_keys->set(i, *key);
+    }
+    DirectHandle<Map> map =
+        NewRegionMapFor(isolate, JS_REGION_OBJECT_TYPE, JSRegionObject::kHeaderSize);
+    Shape shape{isolate->global_handles()->Create(*new_keys).location(),
+                isolate->global_handles()->Create(*map).location()};
+    // Of() may have been invalidated by nothing else; `candidates` is still
+    // the vector of this hash.
+    candidates.push_back(shape);
+    Remember(state, shape);
+    return {new_keys, map};
+  }
+
+  // The map of region arrays of this isolate.
+  static DirectHandle<Map> ArrayMap(Isolate* isolate) {
+    State& state = Of(isolate);
+    if (!state.array_map) {
+      state.array_map =
+          isolate->global_handles()
+              ->Create(*NewRegionMapFor(isolate, JS_REGION_OBJECT_TYPE,
+                                        JSRegionObject::kHeaderSize))
+              .location();
+    }
+    return direct_handle(Cast<Map>(Tagged<Object>(*state.array_map)), isolate);
+  }
+
+ private:
+  static std::pair<DirectHandle<FixedArray>, DirectHandle<Map>> Unpack(
+      Isolate* isolate, const Shape& shape) {
+    return {direct_handle(Cast<FixedArray>(Tagged<Object>(*shape.keys)), isolate),
+            direct_handle(Cast<Map>(Tagged<Object>(*shape.map)), isolate)};
+  }
+  static void Remember(State& state, const Shape& shape) {
+    state.recent[state.next_recent] = shape;
+    state.next_recent = (state.next_recent + 1) % State::kRecent;
+  }
+
+ public:
+ private:
+  static base::Mutex* Mutex() {
+    static base::LeakyObject<base::Mutex> mutex;
+    return mutex.get();
+  }
+  static std::unordered_map<Isolate*, State>* All() {
+    static base::LeakyObject<std::unordered_map<Isolate*, State>> all;
+    return all.get();
+  }
+};
+
+
+
+// Copies a graph of plain objects and arrays into shared space, tagging every
+// copy with the region id. Cycles and shared substructure are preserved.
+class Evacuator {
+ public:
+  Evacuator(Isolate* isolate, int region,
+            DirectHandleVector<JSArrayBuffer>* transfer = nullptr,
+            bool transfer_all = false)
+      : isolate_(isolate),
+        factory_(isolate->factory()),
+        region_(region),
+        transfer_(transfer),
+        transfer_all_(transfer_all),
+        copies_(isolate->heap()),
+        map_shapes_(isolate->heap()) {}
+
+  MaybeDirectHandle<Object> Copy(DirectHandle<Object> value) {
+    if (IsSmi(*value)) return value;
+    if (IsJSRegionObject(*value)) {
+      if (Cast<JSRegionObject>(*value)->region_id() == region_) return value;
+      THROW_NEW_ERROR(isolate_,
+                      NewTypeError(MessageTemplate::kRegionCrossReference));
+    }
+    if (IsPlainObjectOrArray(*value)) return CopyObject(Cast<JSObject>(value));
+    if (IsJSTypedArray(*value)) return CopyTypedArray(Cast<JSTypedArray>(value));
+    if (IsJSReceiver(*value)) {
+      THROW_NEW_ERROR(isolate_,
+                      NewTypeError(MessageTemplate::kRegionCannotMove, value));
+    }
+    DirectHandle<Object> shared;
+    ASSIGN_RETURN_ON_EXCEPTION(isolate_, shared,
+                               Object::Share(isolate_, value, kThrowOnError));
+    if (IsString(*shared)) bytes_ += Cast<String>(*shared)->Size();
+    return shared;
+  }
+
+  size_t bytes() const { return bytes_; }
+
+  // Called once the whole graph is copied: the bytes of transferred buffers
+  // now belong to the region.
+  void DetachTransferredBuffers() {
+    for (const auto& [buffer, store] : moved_buffers_) {
+      USE(JSArrayBuffer::Detach(buffer));
+    }
+  }
+
+ private:
+  bool IsTransferred(DirectHandle<JSArrayBuffer> buffer) const {
+    if (transfer_all_) return buffer->is_detachable();
+    if (transfer_ == nullptr) return false;
+    for (DirectHandle<JSArrayBuffer> candidate : *transfer_) {
+      if (*candidate == *buffer) return true;
+    }
+    return false;
+  }
+
+  MaybeDirectHandle<Object> CopyTypedArray(DirectHandle<JSTypedArray> source) {
+    if (int* index = copies_.Find(source)) return copied_[*index];
+    DirectHandle<JSArrayBuffer> buffer = source->GetBuffer(isolate_);
+    if (source->WasDetached() || source->is_length_tracking() ||
+        source->is_backed_by_rab() || buffer->is_shared() ||
+        buffer->is_resizable_by_js()) {
+      THROW_NEW_ERROR(isolate_,
+                      NewTypeError(MessageTemplate::kRegionCannotMove, source));
+    }
+    size_t length = source->GetLength();
+    size_t byte_length = length * source->element_size();
+    size_t byte_offset = source->byte_offset();
+    if (length > static_cast<size_t>(Smi::kMaxValue) ||
+        byte_offset > static_cast<size_t>(Smi::kMaxValue)) {
+      THROW_NEW_ERROR(isolate_,
+                      NewRangeError(MessageTemplate::kInvalidArrayLength));
+    }
+
+    int store = -1;
+    size_t region_offset = 0;
+    if (IsTransferred(buffer)) {
+      if (!buffer->is_detachable()) {
+        THROW_NEW_ERROR(isolate_, NewTypeError(MessageTemplate::kRegionCannotMove,
+                                               source));
+      }
+      store = MovedStore(buffer);
+      region_offset = byte_offset;
+    } else if (byte_length > 0) {
+      DirectHandle<JSArrayBuffer> copy;
+      ASSIGN_RETURN_ON_EXCEPTION(
+          isolate_, copy,
+          factory_->NewJSArrayBufferAndBackingStore(
+              byte_length, InitializedFlag{false}));
+      memcpy(copy->backing_store(),
+             static_cast<uint8_t*>(buffer->backing_store()) + byte_offset,
+             byte_length);
+      store = RegionBackingStores::Add(copy->GetBackingStore(), region_);
+      bytes_ += byte_length;
+    }
+
+    if (typed_array_map_.is_null()) {
+      typed_array_map_ = indirect_handle(
+          NewRegionMap(JS_REGION_TYPED_ARRAY_TYPE, JSRegionTypedArray::kHeaderSize),
+          isolate_);
+    }
+    SharedObjectSafePublishGuard publish_guard;
+    DirectHandle<JSRegionTypedArray> holder =
+        Cast<JSRegionTypedArray>(factory_->NewJSObjectFromMap(
+            typed_array_map_, AllocationType::kSharedOld, {},
+            NewJSObjectType::kMaybeEmbedderFieldsAndApiWrapper));
+    {
+      DisallowGarbageCollection no_gc;
+      Tagged<FixedArray> empty = ReadOnlyRoots(isolate_).empty_fixed_array();
+      holder->set_region_id(region_);
+      holder->set_keys(empty);
+      holder->set_values(empty);
+      holder->set_array_length(0);
+      bytes_ += JSRegionTypedArray::kHeaderSize;
+      holder->Initialize(store, source->type(),
+                         Smi::FromInt(static_cast<int>(region_offset)),
+                         Smi::FromInt(static_cast<int>(length)));
+    }
+    copies_.Insert(source, static_cast<int>(copied_.size()));
+    copied_.push_back(indirect_handle(holder, isolate_));
+    return holder;
+  }
+
+  // Views of one transferred buffer share a backing store in the region.
+  int MovedStore(DirectHandle<JSArrayBuffer> buffer) {
+    for (const auto& [moved, store] : moved_buffers_) {
+      if (*moved == *buffer) return store;
+    }
+    int store = RegionBackingStores::Add(buffer->GetBackingStore(), region_);
+    bytes_ += buffer->GetByteLength();
+    moved_buffers_.emplace_back(indirect_handle(buffer, isolate_), store);
+    return store;
+  }
+
+  MaybeDirectHandle<Object> CopyObject(DirectHandle<JSObject> source) {
+    if (int* index = copies_.Find(source)) return copied_[*index];
+
+    StackLimitCheck check(isolate_);
+    if (check.HasOverflowed()) {
+      isolate_->StackOverflow();
+      return {};
+    }
+
+    bool is_array = IsJSArray(*source);
+    if (is_array && IsFastElementsKind(source->GetElementsKind())) {
+      return CopyFastArray(Cast<JSArray>(source));
+    }
+    if (!is_array) {
+      int shape = FastShapeOf(source);
+      if (shape >= 0) return CopyFastObject(source, shape);
+    }
+    DirectHandle<FixedArray> source_keys;
+    int length;
+    if (is_array) {
+      uint32_t array_length;
+      CHECK(Object::ToArrayLength(Cast<JSArray>(*source)->length(),
+                                  &array_length));
+      if (array_length > static_cast<uint32_t>(FixedArray::kMaxLength)) {
+        THROW_NEW_ERROR(isolate_, NewRangeError(MessageTemplate::kInvalidArrayLength));
+      }
+      length = static_cast<int>(array_length);
+    } else {
+      ASSIGN_RETURN_ON_EXCEPTION(
+          isolate_, source_keys,
+          KeyAccumulator::GetKeys(isolate_, source, KeyCollectionMode::kOwnOnly,
+                                  ENUMERABLE_STRINGS,
+                                  GetKeysConversion::kConvertToString));
+      length = LengthOf(*source_keys);
+    }
+
+    DirectHandle<Union<FixedArray, Undefined>> keys =
+        factory_->undefined_value();
+    DirectHandle<Map> map;
+    if (is_array) {
+      if (array_map_.is_null()) {
+        array_map_ = indirect_handle(RegionLiterals::ArrayMap(isolate_), isolate_);
+      }
+      map = array_map_;
+    } else {
+      const Shape& shape = ShapeFor(source_keys);
+      keys = shape.keys;
+      map = shape.map;
+    }
+    DirectHandle<FixedArray> values =
+        factory_->NewFixedArray(length, AllocationType::kSharedOld);
+    bytes_ += JSRegionObject::kHeaderSize + FixedArray::SizeFor(length);
+
+    DirectHandle<JSRegionObject> target = NewRegionObject(map, keys, values);
+    copies_.Insert(source, static_cast<int>(copied_.size()));
+    copied_.push_back(indirect_handle(target, isolate_));
+
+    for (int i = 0; i < length; i++) {
+      DirectHandle<Object> value;
+      if (is_array) {
+        ASSIGN_RETURN_ON_EXCEPTION(isolate_, value,
+                                   Object::GetElement(isolate_, source, i));
+      } else {
+        DirectHandle<Name> key(Cast<Name>(source_keys->get(i)), isolate_);
+        ASSIGN_RETURN_ON_EXCEPTION(
+            isolate_, value, JSReceiver::GetProperty(isolate_, source, key));
+      }
+      DirectHandle<Object> copy;
+      ASSIGN_RETURN_ON_EXCEPTION(isolate_, copy, Copy(value));
+      values->set(i, *copy);
+    }
+    return target;
+  }
+
+  // The shape for objects of `source`'s map, if its own properties are plain
+  // enumerable data fields with string keys and it has no elements: then
+  // their values can be read by field index, without looking keys up. -1
+  // otherwise.
+  int FastShapeOf(DirectHandle<JSObject> source) {
+    Tagged<Map> map = source->map();
+    if (int* cached = map_shapes_.Find(map)) return *cached;
+    if (map->is_dictionary_map() || source->elements()->ulength().value() != 0) {
+      return -1;
+    }
+    int count = map->NumberOfOwnDescriptors();
+    DirectHandle<FixedArray> keys = factory_->NewFixedArray(count);
+    {
+      DisallowGarbageCollection no_gc;
+      // The allocation above may have moved the map.
+      Tagged<DescriptorArray> descriptors =
+          source->map()->instance_descriptors();
+      for (InternalIndex i : InternalIndex::Range(count)) {
+        PropertyDetails details = descriptors->GetDetails(i);
+        Tagged<Name> key = descriptors->GetKey(i);
+        if (details.kind() != PropertyKind::kData ||
+            details.location() != PropertyLocation::kField ||
+            (details.attributes() & DONT_ENUM) || !IsString(key)) {
+          return -1;
+        }
+        keys->set(i.as_int(), key);
+      }
+    }
+    int shape = ShapeIndexFor(keys);
+    map_shapes_.Insert(source->map(), shape);
+    return shape;
+  }
+
+  MaybeDirectHandle<Object> CopyFastObject(DirectHandle<JSObject> source,
+                                           int shape) {
+    DirectHandle<FixedArray> keys = shapes_[shape].keys;
+    DirectHandle<Map> map = shapes_[shape].map;
+    int length = LengthOf(*keys);
+    DirectHandle<FixedArray> values =
+        factory_->NewFixedArray(length, AllocationType::kSharedOld);
+    bytes_ += JSRegionObject::kHeaderSize + FixedArray::SizeFor(length);
+    DirectHandle<JSRegionObject> target = NewRegionObject(map, keys, values);
+    copies_.Insert(source, static_cast<int>(copied_.size()));
+    copied_.push_back(indirect_handle(target, isolate_));
+
+    DirectHandle<Map> source_map(source->map(), isolate_);
+    DirectHandle<DescriptorArray> descriptors(
+        source_map->instance_descriptors(), isolate_);
+    for (InternalIndex i : InternalIndex::Range(length)) {
+      // Copying a nested value never runs JS on this path, but a getter of a
+      // value copied the slow way could change the source.
+      if (source->map() != *source_map) {
+        THROW_NEW_ERROR(isolate_,
+                        NewTypeError(MessageTemplate::kRegionCannotMove, source));
+      }
+      PropertyDetails details = descriptors->GetDetails(i);
+      DirectHandle<Object> value = JSObject::FastPropertyAt(
+          isolate_, source, details.representation(),
+          FieldIndex::ForDetails(*source_map, details));
+      DirectHandle<Object> copy;
+      ASSIGN_RETURN_ON_EXCEPTION(isolate_, copy, Copy(value));
+      values->set(i.as_int(), *copy);
+    }
+    return target;
+  }
+
+  // Arrays with fast elements are read from their backing store directly.
+  MaybeDirectHandle<Object> CopyFastArray(DirectHandle<JSArray> source) {
+    uint32_t array_length;
+    CHECK(Object::ToArrayLength(source->length(), &array_length));
+    if (array_length > static_cast<uint32_t>(FixedArray::kMaxLength)) {
+      THROW_NEW_ERROR(isolate_,
+                      NewRangeError(MessageTemplate::kInvalidArrayLength));
+    }
+    int length = static_cast<int>(array_length);
+    if (array_map_.is_null()) {
+      array_map_ = indirect_handle(RegionLiterals::ArrayMap(isolate_), isolate_);
+    }
+    DirectHandle<FixedArray> values =
+        factory_->NewFixedArray(length, AllocationType::kSharedOld);
+    bytes_ += JSRegionObject::kHeaderSize + FixedArray::SizeFor(length);
+    DirectHandle<JSRegionObject> target =
+        NewRegionObject(array_map_, factory_->undefined_value(), values);
+    copies_.Insert(source, static_cast<int>(copied_.size()));
+    copied_.push_back(indirect_handle(target, isolate_));
+
+    ElementsKind kind = source->GetElementsKind();
+    DirectHandle<FixedArrayBase> elements(source->elements(), isolate_);
+    for (int i = 0; i < length; i++) {
+      if (source->elements() != *elements ||
+          source->GetElementsKind() != kind) {
+        THROW_NEW_ERROR(isolate_,
+                        NewTypeError(MessageTemplate::kRegionCannotMove, source));
+      }
+      DirectHandle<Object> value = factory_->undefined_value();
+      if (i < static_cast<int>(elements->ulength().value())) {
+        if (IsDoubleElementsKind(kind)) {
+          Tagged<FixedDoubleArray> doubles = Cast<FixedDoubleArray>(*elements);
+          if (!doubles->is_the_hole(i)) {
+            value = factory_->NewNumber(doubles->get_scalar(i));
+          }
+        } else {
+          Tagged<Object> element = Cast<FixedArray>(*elements)->get(i);
+          if (!IsTheHole(element)) value = direct_handle(element, isolate_);
+        }
+      }
+      DirectHandle<Object> copy;
+      ASSIGN_RETURN_ON_EXCEPTION(isolate_, copy, Copy(value));
+      values->set(i, *copy);
+    }
+    return target;
+  }
+
+  // Only plain objects and arrays can be copied: anything with another
+  // prototype, e.g. a class instance, would lose its class in the region.
+  bool IsPlainObjectOrArray(Tagged<Object> value) const {
+    if (!IsJSObject(value)) return false;
+    Tagged<Map> map = Cast<JSObject>(value)->map();
+    Tagged<Object> prototype = map->prototype();
+    switch (map->instance_type()) {
+      case JS_OBJECT_TYPE:
+        return IsNull(prototype) ||
+               prototype == *isolate_->initial_object_prototype();
+      case JS_ARRAY_TYPE:
+        return prototype == *isolate_->initial_array_prototype();
+      default:
+        return false;
+    }
+  }
+
+  // Objects with the same keys in the same order share a map and a keys
+  // array, so that inline caches can map a (map, name) pair to an index.
+  struct Shape {
+    Handle<FixedArray> keys;
+    Handle<Map> map;
+  };
+
+  const Shape& ShapeFor(DirectHandle<FixedArray> source_keys) {
+    return shapes_[ShapeIndexFor(source_keys)];
+  }
+
+  int ShapeIndexFor(DirectHandle<FixedArray> source_keys) {
+    for (size_t i = 0; i < shapes_.size(); i++) {
+      if (SameKeys(*shapes_[i].keys, *source_keys)) return static_cast<int>(i);
+    }
+    // Not seen in this copy: the isolate-wide shape, so that objects with the
+    // same keys share a map across copies and literals.
+    DirectHandleVector<String> keys(isolate_);
+    for (int i = 0; i < LengthOf(*source_keys); i++) {
+      keys.push_back(direct_handle(Cast<String>(source_keys->get(i)), isolate_));
+    }
+    auto [shape_keys, map] = RegionLiterals::ShapeFor(isolate_, keys);
+    shapes_.push_back({indirect_handle(shape_keys, isolate_),
+                       indirect_handle(map, isolate_)});
+    return static_cast<int>(shapes_.size()) - 1;
+  }
+
+  static bool SameKeys(Tagged<FixedArray> keys, Tagged<FixedArray> other) {
+    DisallowGarbageCollection no_gc;
+    int length = LengthOf(keys);
+    if (length != LengthOf(other)) return false;
+    for (int i = 0; i < length; i++) {
+      if (!Cast<String>(keys->get(i))->Equals(Cast<String>(other->get(i)))) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  DirectHandle<JSRegionObject> NewRegionObject(
+      DirectHandle<Map> map, DirectHandle<Union<FixedArray, Undefined>> keys,
+      DirectHandle<FixedArray> values) {
+    SharedObjectSafePublishGuard publish_guard;
+    DirectHandle<JSRegionObject> object =
+        Cast<JSRegionObject>(factory_->NewJSObjectFromMap(
+            map, AllocationType::kSharedOld, {},
+            NewJSObjectType::kMaybeEmbedderFieldsAndApiWrapper));
+    DisallowGarbageCollection no_gc;
+    object->set_region_id(region_);
+    object->set_keys(*keys);
+    object->set_values(*values);
+    object->set_array_length(values->ulength().value());
+    return object;
+  }
+
+  DirectHandle<Map> NewRegionMap(InstanceType type = JS_REGION_OBJECT_TYPE,
+                                 int instance_size = JSRegionObject::kHeaderSize) {
+    DirectHandle<Map> map = factory_->NewContextlessMap(
+        type, instance_size, DICTIONARY_ELEMENTS, 0, AllocationType::kSharedMap);
+    DisallowGarbageCollection no_gc;
+    map->SetInObjectUnusedPropertyFields(0);
+    map->set_is_extensible(false);
+    map->set_prototype_validity_cell(Map::kNoValidityCellSentinel,
+                                     kRelaxedStore, SKIP_WRITE_BARRIER);
+    return map;
+  }
+
+  Isolate* const isolate_;
+  Factory* const factory_;
+  const int region_;
+  DirectHandleVector<JSArrayBuffer>* const transfer_;
+  const bool transfer_all_;
+  std::vector<std::pair<Handle<JSArrayBuffer>, int>> moved_buffers_;
+  size_t bytes_ = 0;
+  Handle<Map> typed_array_map_;
+  Handle<Map> array_map_;
+  std::vector<Shape> shapes_;
+  IdentityMap<int, FreeStoreAllocationPolicy> copies_;
+  // Shape index by the map of fast source objects.
+  IdentityMap<int, FreeStoreAllocationPolicy> map_shapes_;
+  std::vector<Handle<JSRegionObject>> copied_;
+};
+
+}  // namespace
+
+// static
+MaybeDirectHandle<Object> JSRegionObject::Evacuate(
+    Isolate* isolate, int region, DirectHandle<Object> value,
+    DirectHandleVector<JSArrayBuffer>* transfer, bool transfer_all) {
+  if (!RegionRegistry::IsOwner(region, isolate)) {
+    ThrowAccessError(isolate, region, Access::kWrite);
+    return {};
+  }
+  Evacuator evacuator(isolate, region, transfer, transfer_all);
+  DirectHandle<Object> result;
+  if (!evacuator.Copy(value).ToHandle(&result)) return {};
+  evacuator.DetachTransferredBuffers();
+  RegionRegistry::AddBytes(region, evacuator.bytes());
+  return result;
+}
+
+// static
+MaybeHandle<Object> JSRegionObject::ToJSValue(Isolate* isolate,
+                                              Handle<Object> value) {
+  if (!IsJSRegionTypedArray(*value)) return value;
+  DirectHandle<JSRegionTypedArray> holder = Cast<JSRegionTypedArray>(value);
+  Factory* factory = isolate->factory();
+  int region = holder->region_id();
+  // Plain fields are checked on every access, but a view reads raw memory:
+  // it may only exist while this isolate is allowed to read the region.
+  if (RegionRegistry::IsFrozen(region) &&
+      !RegionRegistry::IsFrozenBy(region, isolate) &&
+      !RegionRegistry::IsBorrowedBy(region, isolate)) {
+    THROW_NEW_ERROR(isolate,
+                    NewTypeError(MessageTemplate::kRegionBorrowRequired,
+                                 factory->NewNumberFromInt(region)));
+  }
+  std::shared_ptr<BackingStore> store =
+      RegionBackingStores::Get(holder->backing_store_id());
+  Handle<JSArrayBuffer> buffer =
+      store ? factory->NewJSArrayBuffer(std::move(store))
+            : factory
+                  ->NewJSArrayBufferAndBackingStore(
+                      0, InitializedFlag{true})
+                  .ToHandleChecked();
+  if (RegionRegistry::IsFrozen(region)) {
+    // Readers of a frozen region share the bytes but cannot write them.
+    buffer->set_is_immutable(ImmutableFlag{true});
+    if (Protectors::IsArrayBufferMutableIntact(isolate)) {
+      Protectors::InvalidateArrayBufferMutable(isolate);
+    }
+  }
+  RegionViews::Track(isolate, region, buffer);
+  return factory->NewJSTypedArray(holder->element_type(), buffer,
+                                  holder->byte_offset(), holder->length());
+}
+
+// static
+void JSRegionObject::DetachViews(Isolate* isolate, int region) {
+  for (Address* location : RegionViews::Take(isolate, region)) {
+    DirectHandle<JSArrayBuffer> buffer(
+        Cast<JSArrayBuffer>(Tagged<Object>(*location)), isolate);
+    // Views of a frozen region are immutable, which JSArrayBuffer::Detach
+    // refuses; their memory belongs to the region, so detach them directly.
+    if (!buffer->was_detached()) {
+      JSArrayBuffer::DetachInternal(buffer, false, isolate);
+    }
+    GlobalHandles::Destroy(location);
+  }
+}
+
+// static
+void JSRegionObject::ReleaseBackingStores(int region) {
+  RegionBackingStores::ReleaseRegion(region);
+}
+
+// static
+void JSRegionObject::DetachFrozenViewsIfUnused(Isolate* isolate, int region) {
+  if (RegionRegistry::IsFrozenBy(region, isolate) ||
+      RegionRegistry::IsBorrowedBy(region, isolate)) {
+    return;
+  }
+  DetachViews(isolate, region);
+}
+
+namespace {
+void ForgetRegionLiterals(Isolate* isolate);
+}  // namespace
+
+// static
+void JSRegionObject::ForgetIsolate(Isolate* isolate) {
+  for (Address* location : RegionViews::Take(isolate, -1)) {
+    GlobalHandles::Destroy(location);
+  }
+  ForgetRegionLiterals(isolate);
+  RegionRegistry::ForgetReadTable(isolate);
+}
+
+namespace {
+
+void ForgetRegionLiterals(Isolate* isolate) { RegionLiterals::Forget(isolate); }
+
+MaybeDirectHandle<Object> LiteralValue(Isolate* isolate, int region,
+                                       DirectHandle<Object> value) {
+  if (IsSmi(*value)) return value;
+  if (IsJSRegionObject(*value)) {
+    if (Cast<JSRegionObject>(*value)->region_id() == region) return value;
+    THROW_NEW_ERROR(isolate,
+                    NewTypeError(MessageTemplate::kRegionCrossReference));
+  }
+  // Typed arrays have their bytes outside the heap; those are copied.
+  if (IsJSTypedArray(*value)) return Evacuator(isolate, region).Copy(value);
+  if (IsJSReceiver(*value)) {
+    THROW_NEW_ERROR(isolate,
+                    NewTypeError(MessageTemplate::kRegionLiteralPlainValue));
+  }
+  return Object::Share(isolate, value, kThrowOnError);
+}
+
+}  // namespace
+
+// static
+void JSRegionObject::PushCurrent(Isolate* isolate, int region) {
+  RegionLiterals::Of(isolate).current.push_back(region);
+}
+
+// static
+void JSRegionObject::PopCurrent(Isolate* isolate, int region) {
+  std::vector<int>& current = RegionLiterals::Of(isolate).current;
+  for (auto it = current.rbegin(); it != current.rend(); ++it) {
+    if (*it == region) {
+      current.erase(std::next(it).base());
+      return;
+    }
+  }
+}
+
+// static
+int JSRegionObject::Current(Isolate* isolate) {
+  std::vector<int>& current = RegionLiterals::Of(isolate).current;
+  return current.empty() ? -1 : current.back();
+}
+
+// static
+MaybeDirectHandle<JSRegionObject> JSRegionObject::NewLiteral(
+    Isolate* isolate, DirectHandleVector<String>* keys,
+    const DirectHandleVector<Object>& values) {
+  Factory* factory = isolate->factory();
+  int region = Current(isolate);
+  if (region < 0) {
+    THROW_NEW_ERROR(isolate,
+                    NewTypeError(MessageTemplate::kRegionLiteralNoRegion));
+  }
+  if (!RegionRegistry::IsOwner(region, isolate)) {
+    ThrowAccessError(isolate, region, Access::kWrite);
+    return {};
+  }
+  int length = static_cast<int>(values.size());
+
+  // The shape: the same keys get the same keys array and map.
+  DirectHandle<Union<FixedArray, Undefined>> shape_keys =
+      factory->undefined_value();
+  DirectHandle<Map> map;
+  if (keys) {
+    auto [known_keys, known_map] = RegionLiterals::ShapeFor(isolate, *keys);
+    shape_keys = known_keys;
+    map = known_map;
+  } else {
+    map = RegionLiterals::ArrayMap(isolate);
+  }
+
+  DirectHandle<FixedArray> object_values =
+      factory->NewFixedArray(length, AllocationType::kSharedOld);
+  size_t bytes = 0;
+  for (int i = 0; i < length; i++) {
+    DirectHandle<Object> value;
+    ASSIGN_RETURN_ON_EXCEPTION(isolate, value,
+                               LiteralValue(isolate, region, values[i]));
+    // Count strings copied into shared space, as region.run() does.
+    if (IsString(*value) && *value != *values[i]) {
+      bytes += Cast<String>(*value)->Size();
+    }
+    object_values->set(i, *value);
+  }
+  SharedObjectSafePublishGuard publish_guard;
+  DirectHandle<JSRegionObject> object =
+      Cast<JSRegionObject>(factory->NewJSObjectFromMap(
+          map, AllocationType::kSharedOld, {},
+          NewJSObjectType::kMaybeEmbedderFieldsAndApiWrapper));
+  DisallowGarbageCollection no_gc;
+  object->set_region_id(region);
+  object->set_keys(*shape_keys);
+  object->set_values(*object_values);
+  object->set_array_length(static_cast<uint32_t>(length));
+  RegionRegistry::AddBytes(region,
+                           bytes + kHeaderSize + FixedArray::SizeFor(length));
+  return object;
+}
+
+bool IsJSRegionArray(Tagged<HeapObject> object) {
+  return IsJSRegionObject(object) && Cast<JSRegionObject>(object)->is_array();
+}
+
+// static
+bool JSRegionObject::CheckReadAccess(Isolate* isolate,
+                                     DirectHandle<JSRegionObject> object) {
+  return CheckAccess(isolate, *object, Access::kRead);
+}
+
+// static
+int JSRegionObject::LookupIndexForIC(LookupIterator* it) {
+  Isolate* isolate = it->isolate();
+  DirectHandle<JSRegionObject> object = it->GetHolder<JSRegionObject>();
+  if (it->IsElement() ||
+      !CanAccess(isolate, object->region_id(), Access::kRead)) {
+    return kNotFound;
+  }
+  if (IsArrayLength(isolate, *object, it)) return kArrayLengthIndex;
+  return FindIndex(object, it);
+}
+
+// static
+MaybeHandle<Object> JSRegionObject::GetProperty(LookupIterator* it) {
+  Isolate* isolate = it->isolate();
+  DirectHandle<JSRegionObject> object = it->GetHolder<JSRegionObject>();
+  if (!CheckAccess(isolate, *object, Access::kRead)) return {};
+  if (IsArrayLength(isolate, *object, it) || FindIndex(object, it) >= 0) {
+    return ReadOwnedProperty(isolate, object, it);
+  }
+  LookupIterator prototype_it = PrototypeLookup(isolate, object, it);
+  return Object::GetProperty(&prototype_it);
+}
+
+// static
+Handle<Object> JSRegionObject::GetDataProperty(LookupIterator* it) {
+  Isolate* isolate = it->isolate();
+  DirectHandle<JSRegionObject> object = it->GetHolder<JSRegionObject>();
+  Handle<Object> value;
+  if (!CanAccess(isolate, object->region_id(), Access::kRead)) {
+    return isolate->factory()->undefined_value();
+  }
+  // Never throws: a typed array that may not be viewed reads as undefined.
+  if (!ReadOwnedProperty(isolate, object, it).ToHandle(&value)) {
+    isolate->clear_exception();
+    return isolate->factory()->undefined_value();
+  }
+  return value;
+}
+
+// static
+Maybe<bool> JSRegionObject::HasProperty(LookupIterator* it) {
+  Isolate* isolate = it->isolate();
+  DirectHandle<JSRegionObject> object = it->GetHolder<JSRegionObject>();
+  if (!CheckAccess(isolate, *object, Access::kRead)) return Nothing<bool>();
+  if (IsArrayLength(isolate, *object, it) || FindIndex(object, it) >= 0) {
+    return Just(true);
+  }
+  LookupIterator prototype_it = PrototypeLookup(isolate, object, it);
+  return JSReceiver::HasProperty(&prototype_it);
+}
+
+// static
+Maybe<PropertyAttributes> JSRegionObject::GetPropertyAttributes(
+    LookupIterator* it) {
+  Isolate* isolate = it->isolate();
+  DirectHandle<JSRegionObject> object = it->GetHolder<JSRegionObject>();
+  if (!CheckAccess(isolate, *object, Access::kRead)) {
+    return Nothing<PropertyAttributes>();
+  }
+  if (IsArrayLength(isolate, *object, it)) {
+    return Just(static_cast<PropertyAttributes>(DONT_ENUM | DONT_DELETE));
+  }
+  return Just(FindIndex(object, it) >= 0 ? DONT_DELETE : ABSENT);
+}
+
+// static
+Maybe<bool> JSRegionObject::SetProperty(LookupIterator* it,
+                                        DirectHandle<Object> value,
+                                        Maybe<ShouldThrow> should_throw) {
+  Isolate* isolate = it->isolate();
+  DirectHandle<JSRegionObject> object = it->GetHolder<JSRegionObject>();
+  if (!CheckAccess(isolate, *object, Access::kWrite)) return Nothing<bool>();
+
+  // Arrays grow and shrink: through `length`, and by writing at or past the
+  // end, which is what push() does. Objects keep their shape.
+  if (IsArrayLength(isolate, *object, it)) {
+    uint32_t new_length;
+    if (!Object::ToArrayLength(*value, &new_length)) {
+      RETURN_FAILURE(isolate, kThrowOnError,
+                     NewRangeError(MessageTemplate::kInvalidArrayLength));
+    }
+    if (new_length > static_cast<uint32_t>(FixedArray::kMaxLength)) {
+      RETURN_FAILURE(isolate, kThrowOnError,
+                     NewRangeError(MessageTemplate::kInvalidArrayLength));
+    }
+    EnsureArrayCapacity(isolate, object, new_length);
+    Tagged<FixedArray> values = object->values();
+    for (uint32_t i = new_length; i < object->array_length(); i++) {
+      values->set(i, ReadOnlyRoots(isolate).undefined_value());
+    }
+    object->set_array_length(new_length);
+    return Just(true);
+  }
+  int index = FindIndex(object, it);
+  bool append = index < 0 && object->is_array() && it->IsElement() &&
+                it->index() < static_cast<size_t>(FixedArray::kMaxLength);
+  if (index < 0 && !append) {
+    RETURN_FAILURE(isolate, kThrowOnError,
+                   NewTypeError(MessageTemplate::kRegionNotExtensible,
+                                it->GetName()));
+  }
+  if (IsJSReceiver(*value) && !IsJSRegionObject(*value) &&
+      !IsJSTypedArray(*value)) {
+    RETURN_FAILURE(isolate, kThrowOnError,
+                   NewTypeError(MessageTemplate::kRegionCrossReference));
+  }
+  // Numbers, shared primitives and objects of the region go in as they are;
+  // only the rest needs the evacuator (strings to share, typed arrays).
+  DirectHandle<Object> shared = value;
+  bool as_is = IsSmi(*value) ||
+               (IsJSRegionObject(*value) &&
+                Cast<JSRegionObject>(*value)->region_id() == object->region_id()) ||
+               (!IsJSReceiver(*value) &&
+                (HeapLayout::InReadOnlySpace(Cast<HeapObject>(*value)) ||
+                 HeapLayout::InAnySharedSpace(Cast<HeapObject>(*value))));
+  if (!as_is) {
+    ASSIGN_RETURN_ON_EXCEPTION_VALUE(
+        isolate, shared,
+        Evacuator(isolate, object->region_id()).Copy(value), Nothing<bool>());
+  }
+  if (append) {
+    index = static_cast<int>(it->index());
+    EnsureArrayCapacity(isolate, object, index + 1);
+    object->set_array_length(index + 1);
+  }
+  object->values()->set(index, *shared);
+  return Just(true);
+}
+
+// static
+void JSRegionObject::EnsureArrayCapacity(Isolate* isolate,
+                                         DirectHandle<JSRegionObject> array,
+                                         uint32_t capacity) {
+  uint32_t old_capacity = array->values()->ulength().value();
+  if (capacity <= old_capacity) return;
+  // Grow by half, like JSArray, so that a series of push() stays linear.
+  uint32_t new_capacity =
+      std::min(static_cast<uint32_t>(FixedArray::kMaxLength),
+               std::max(capacity, old_capacity + old_capacity / 2 + 16));
+  DirectHandle<FixedArray> values = isolate->factory()->NewFixedArray(
+      new_capacity, AllocationType::kSharedOld);
+  DisallowGarbageCollection no_gc;
+  Tagged<FixedArray> old_values = array->values();
+  for (uint32_t i = 0; i < array->array_length(); i++) {
+    values->set(i, old_values->get(i));
+  }
+  array->set_values(*values);
+  RegionRegistry::AddBytes(array->region_id(),
+                           FixedArray::SizeFor(new_capacity) -
+                               FixedArray::SizeFor(old_capacity));
+}
+
+// static
+Maybe<bool> JSRegionObject::DeleteProperty(LookupIterator* it) {
+  Isolate* isolate = it->isolate();
+  DirectHandle<JSRegionObject> object = it->GetHolder<JSRegionObject>();
+  if (!CheckAccess(isolate, *object, Access::kWrite)) return Nothing<bool>();
+  // An element of an array becomes undefined, which is what pop() and
+  // splice() need; holes are not kept. Properties of objects stay.
+  if (object->is_array() && it->IsElement()) {
+    int index = FindIndex(object, it);
+    if (index >= 0) {
+      object->values()->set(index, ReadOnlyRoots(isolate).undefined_value());
+    }
+    return Just(true);
+  }
+  if (FindIndex(object, it) < 0 && !IsArrayLength(isolate, *object, it)) {
+    return Just(true);
+  }
+  RETURN_FAILURE(isolate, kThrowOnError,
+                 NewTypeError(MessageTemplate::kRegionNotExtensible,
+                              it->GetName()));
+}
+
+}  // namespace internal
+}  // namespace v8
