+// found in the LICENSE file.
+
+#ifndef V8_OBJECTS_JS_REGION_INL_H_
+#define V8_OBJECTS_JS_REGION_INL_H_
+
+#include "src/objects/js-region.h"
+// Include the non-inl header before the rest of the headers.
+
+#include "src/objects/objects-inl.h"
+#include "src/objects/oddball-predicates-inl.h"
+#include "src/objects/tagged-field-inl.h"
+
+// Has to be the last include (doesn't have include guards):
+#include "src/objects/object-macros.h"
+
+namespace v8 {
+namespace internal {
+
+DEF_CAST_TRAITS(JSRegionObject)
+
+int JSRegionObject::region_id() const { return region_id_.load().value(); }
+
+void JSRegionObject::set_region_id(int value) {
+  region_id_.store(this, Smi::FromInt(value));
+}
+
+Tagged<Union<FixedArray, Undefined>> JSRegionObject::keys() const {
+  return keys_.load();
+}
+
+void JSRegionObject::set_keys(Tagged<Union<FixedArray, Undefined>> value,
+                              WriteBarrierMode mode) {
+  keys_.store(this, value, mode);
+}
+
+Tagged<FixedArray> JSRegionObject::values() const { return values_.load(); }
+
+void JSRegionObject::set_values(Tagged<FixedArray> value,
+                                WriteBarrierMode mode) {
+  values_.store(this, value, mode);
+}
+
+bool JSRegionObject::is_array() const { return IsUndefined(keys()); }
+
+uint32_t JSRegionObject::array_length() const {
+  return static_cast<uint32_t>(array_length_.load().value());
+}
+
+void JSRegionObject::set_array_length(uint32_t value) {
+  array_length_.store(this, Smi::FromInt(static_cast<int>(value)));
+}
+
+DEF_CAST_TRAITS(JSRegionTypedArray)
+
+int JSRegionTypedArray::backing_store_id() const {
+  return backing_store_id_.load().value();
+}
+
+ExternalArrayType JSRegionTypedArray::element_type() const {
+  return static_cast<ExternalArrayType>(element_type_.load().value());
+}
+
+size_t JSRegionTypedArray::byte_offset() const {
+  return static_cast<size_t>(Object::NumberValue(byte_offset_.load()));
+}
+
+size_t JSRegionTypedArray::length() const {
+  return static_cast<size_t>(Object::NumberValue(length_.load()));
+}
+
+void JSRegionTypedArray::Initialize(int backing_store_id,
+                                    ExternalArrayType element_type,
+                                    Tagged<Number> byte_offset,
+                                    Tagged<Number> length) {
+  backing_store_id_.store(this, Smi::FromInt(backing_store_id));
+  element_type_.store(this, Smi::FromInt(static_cast<int>(element_type)));
+  byte_offset_.store(this, byte_offset);
+  length_.store(this, length);
+}
+
+}  // namespace internal
+}  // namespace v8
+
+#include "src/objects/object-macros-undef.h"
+
+#endif  // V8_OBJECTS_JS_REGION_INL_H_
