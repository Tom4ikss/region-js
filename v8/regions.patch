+// region.object(value): a plain object copied into this region.
+void Shell::RegionNewObject(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  if (!CheckObjectArgument(info, "region.object")) return;
+  CreateInRegion(info, RegionIdOf(info), info[0]);
+}
+
+// region.array(...items): an array of the items in this region.
+void Shell::RegionNewArray(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Local<Array> items;
+  if (!ArgumentsArray(info).ToLocal(&items)) return;
+  CreateInRegion(info, RegionIdOf(info), items);
+}
+
+// Region.object(value) and Region.array(...items): the same in the current
+// region.
+void Shell::RegionCurrentObject(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  if (!CheckObjectArgument(info, "Region.object")) return;
+  int region = CurrentRegion(info, "object");
+  if (region >= 0) CreateInRegion(info, region, info[0]);
+}
+
+void Shell::RegionCurrentArray(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
