+  CHECK(IsNull(map()->prototype()));
+  CHECK_LE(0, region_id());
+  CHECK_LT(region_id(), RegionRegistry::kMaxRegions);
+  Object::VerifyPointer(isolate, values());
+  CHECK(HeapLayout::InAnySharedSpace(values()));
+  if (!is_array()) {
+    Tagged<FixedArray> keys = Cast<FixedArray>(this->keys());
+    CHECK(HeapLayout::InAnySharedSpace(keys));
+    CHECK_EQ(keys->length(), values()->length());
+  } else {
+    CHECK_LE(array_length(), values()->ulength().value());
+    for (uint32_t i = array_length(); i < values()->ulength().value(); i++) {
+      CHECK(IsUndefined(values()->get(i)));
+    }
+  }
+}
