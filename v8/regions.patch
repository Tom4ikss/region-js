+namespace {
+
+// Frees a region of this isolate: revokes every access, detaches this
+// isolate's typed array views and releases the typed array memory at once.
+// The objects themselves are emptied at the next shared GC.
+i::RegionRegistry::FreeResult FreeRegion(Isolate* isolate, int region) {
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  i::RegionRegistry::FreeResult result =
+      i::RegionRegistry::Free(region, i_isolate);
+  if (result == i::RegionRegistry::FreeResult::kFreed) {
+    i::JSRegionObject::DetachViews(i_isolate, region);
+    i::JSRegionObject::ReleaseBackingStores(region);
+  }
+  return result;
+}
+
+}  // namespace
+
+void Shell::RegionFree(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Isolate* isolate = info.GetIsolate();
+  int region = RegionIdOf(info);
+  switch (FreeRegion(isolate, region)) {
+    case i::RegionRegistry::FreeResult::kFreed:
+      return;
+    case i::RegionRegistry::FreeResult::kBorrowed: {
+      std::string message =
+          "Region is still borrowed by " +
+          std::to_string(i::RegionRegistry::Readers(region)) + " reader(s)";
+      ThrowError(isolate, message.c_str());
+      return;
+    }
+    case i::RegionRegistry::FreeResult::kNotOwner:
+      ThrowError(isolate,
+                 i::RegionRegistry::IsFreed(region) ? "Region was already freed"
+                 : i::RegionRegistry::IsInTransit(region)
+                     ? "Region is being moved and cannot be freed"
+                 : i::RegionRegistry::IsFrozen(region)
+                     ? "Region was frozen by another isolate"
+                     : "Region is not owned by this isolate");
+      return;
+  }
+}
