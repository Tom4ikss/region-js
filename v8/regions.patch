+  region_template->Set(isolate, "toJS",
+                       FunctionTemplate::New(isolate, RegionToJS));
+  for (auto [name, callback] :
+       {std::pair{"freeze", RegionFreeze}, std::pair{"thaw", RegionThaw},
+        std::pair{"borrow", RegionBorrow}, std::pair{"free", RegionFree},
