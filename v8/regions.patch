+void Shell::RegionOwner(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  info.GetReturnValue().Set(i::RegionRegistry::Owner(RegionIdOf(info)));
+}
+
+// Returns a handle to the region that owns a region object. It does not change
+// ownership; it lets the owner put the region into a transfer list.
+void Shell::RegionOf(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  Isolate* isolate = info.GetIsolate();
+  i::DirectHandle<i::Object> value =
+      info.Length() > 0 ? Utils::OpenDirectHandle(*info[0])
+                        : i::DirectHandle<i::Object>();
+  if (value.is_null() || !i::IsJSRegionObject(*value)) {
+    ThrowError(isolate, "Region.of() expects an object from a region");
+    return;
+  }
+  int region = i::Cast<i::JSRegionObject>(*value)->region_id();
+  Local<Object> handle;
+  if (!PerIsolateData::Get(isolate)
+           ->GetRegionCtor()
+           ->InstanceTemplate()
+           ->NewInstance(isolate->GetCurrentContext())
+           .ToLocal(&handle)) {
+    return;
+  }
+  handle->SetInternalField(0, Int32::New(isolate, region));
+  PerIsolateData::Get(isolate)->TrackRegionHandle(handle, region);
+  info.GetReturnValue().Set(handle);
+}
