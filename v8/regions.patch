+uintptr_t OwnerKey(Isolate* isolate) {
+  return reinterpret_cast<uintptr_t>(isolate);
+}
+
+// Guards next_region_ and the free list.
+base::Mutex* RegionsMutex() {
+  static base::LeakyObject<base::Mutex> mutex;
+  return mutex.get();
+}
+
+std::vector<int>* FreeRegions() {
+  static base::LeakyObject<std::vector<int>> free_regions;
+  return free_regions.get();
+}
+
+// Bytes of the typed arrays in regions, indexed by
+// JSRegionTypedArray::backing_store_id.
+class RegionBackingStores {
+ public:
+  static int Add(std::shared_ptr<BackingStore> store, int region) {
+    if (!store) return -1;
+    base::MutexGuard guard(Mutex());
+    std::vector<std::shared_ptr<BackingStore>>& stores = Stores();
+    if (!Free().empty()) {
+      int id = Free().back();
+      Free().pop_back();
+      stores[id] = std::move(store);
+      Regions()[id] = region;
+      return id;
+    }
+    stores.push_back(std::move(store));
+    Regions().push_back(region);
+    return static_cast<int>(stores.size()) - 1;
+  }
+
+  // Drops the stores of a freed region; its holders are emptied later.
+  static void ReleaseRegion(int region) {
+    base::MutexGuard guard(Mutex());
+    std::vector<std::shared_ptr<BackingStore>>& stores = Stores();
+    for (size_t id = 0; id < stores.size(); id++) {
+      if (!stores[id] || Regions()[id] != region) continue;
+      stores[id].reset();
+      Free().push_back(static_cast<int>(id));
+    }
+  }
+
+  static std::shared_ptr<BackingStore> Get(int id) {
+    if (id < 0) return nullptr;
+    base::MutexGuard guard(Mutex());
+    return Stores()[id];
+  }
+
+  static int Count() {
+    base::MutexGuard guard(Mutex());
+    return static_cast<int>(Stores().size());
+  }
+
+  // Drops the stores no live JSRegionTypedArray refers to. Views created from
+  // them keep their own references, so the memory goes away with the last one.
+  static void ReleaseUnused(const std::vector<bool>& live) {
+    base::MutexGuard guard(Mutex());
+    std::vector<std::shared_ptr<BackingStore>>& stores = Stores();
+    for (size_t id = 0; id < live.size(); id++) {
+      if (live[id] || !stores[id]) continue;
+      stores[id].reset();
+      Free().push_back(static_cast<int>(id));
+    }
+  }
+
+ private:
+  static base::Mutex* Mutex() {
+    static base::LeakyObject<base::Mutex> mutex;
+    return mutex.get();
+  }
+  static std::vector<int>& Regions() {
+    static base::LeakyObject<std::vector<int>> regions;
+    return *regions.get();
+  }
+  static std::vector<std::shared_ptr<BackingStore>>& Stores() {
+    static base::LeakyObject<std::vector<std::shared_ptr<BackingStore>>> stores;
+    return *stores.get();
+  }
+  static std::vector<int>& Free() {
+    static base::LeakyObject<std::vector<int>> free;
+    return *free.get();
+  }
+};
+
+// Writable typed array views an isolate created for region typed arrays. They
+// are detached when the isolate gives up write access to the region, so that
+// it cannot touch bytes another isolate now owns.
+struct TrackedView {
+  int region;
+  // Weak global handle to the view's JSArrayBuffer; reset to nullptr by the GC.
+  Address* location;
+};
+
+class RegionViews {
+ public:
+  static void Track(Isolate* isolate, int region,
+                    DirectHandle<JSArrayBuffer> buffer) {
+    auto view = std::make_unique<TrackedView>(TrackedView{
+        region, isolate->global_handles()->Create(*buffer).location()});
+    GlobalHandles::MakeWeak(&view->location);
+    base::MutexGuard guard(Mutex());
+    std::vector<std::unique_ptr<TrackedView>>& views = (*All())[isolate];
+    std::erase_if(views, [](const auto& v) { return v->location == nullptr; });
+    views.push_back(std::move(view));
+  }
+
+  // Borrows of frozen regions held by each isolate, by region id.
+  static int ChangeBorrows(Isolate* isolate, int region, int delta) {
+    base::MutexGuard guard(Mutex());
+    std::unordered_map<int, int>& borrows = (*Borrows())[isolate];
+    int count = borrows[region] += delta;
+    DCHECK_GE(count, 0);
+    if (count == 0) borrows.erase(region);
+    return count;
+  }
+
+  static bool HasBorrow(Isolate* isolate, int region) {
+    base::MutexGuard guard(Mutex());
+    auto it = Borrows()->find(isolate);
+    return it != Borrows()->end() && it->second.contains(region);
+  }
+
+  // Removes and returns the live views of `region` (all regions if -1).
+  static std::vector<Address*> Take(Isolate* isolate, int region) {
+    std::vector<Address*> taken;
+    base::MutexGuard guard(Mutex());
+    auto it = All()->find(isolate);
+    if (it == All()->end()) return taken;
+    std::erase_if(it->second, [&](const auto& v) {
+      if (v->location == nullptr) return true;
+      if (region != -1 && v->region != region) return false;
+      taken.push_back(v->location);
+      return true;
+    });
+    if (region == -1) {
+      All()->erase(it);
+      Borrows()->erase(isolate);
+    }
+    return taken;
+  }
+
+ private:
+  static base::Mutex* Mutex() {
+    static base::LeakyObject<base::Mutex> mutex;
+    return mutex.get();
+  }
+  static std::unordered_map<Isolate*, std::vector<std::unique_ptr<TrackedView>>>*
+  All() {
+    static base::LeakyObject<std::unordered_map<
+        Isolate*, std::vector<std::unique_ptr<TrackedView>>>>
+        views;
+    return views.get();
+  }
+  static std::unordered_map<Isolate*, std::unordered_map<int, int>>*
+  Borrows() {
+    static base::LeakyObject<
+        std::unordered_map<Isolate*, std::unordered_map<int, int>>>
+        borrows;
+    return borrows.get();
+  }
+};
