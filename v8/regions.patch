+void Shell::RegionDispose(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  DCHECK(i::ValidateCallbackInfo(info));
+  USE(FreeRegion(info.GetIsolate(), RegionIdOf(info)));
+}
