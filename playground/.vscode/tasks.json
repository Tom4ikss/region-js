{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run with d8 (regions)",
      "type": "shell",
      "command": "${config:regions.d8Path}",
      "args": ["--harmony-regions", "--module", "--expose-gc", "--max-serializer-memory=4000", "${file}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "d8",
        "fileLocation": "absolute",
        "pattern": { "regexp": "^(/[^:]+):(\\d+): (.*)$", "file": 1, "line": 2, "message": 3 }
      }
    }
  ]
}
