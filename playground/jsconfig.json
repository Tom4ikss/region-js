{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "ESNext.Disposable"
    ],
    "module": "ESNext",
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "types": [],
    "moduleDetection": "force",
    "noImplicitAny": false
  },
  "include": [
    "types/**/*.d.ts",
    "examples/**/*.js",
    "experimental/**/*.js",
    "*.js"
  ]
}
