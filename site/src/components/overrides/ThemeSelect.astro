---
// Theme switch: one button that cycles auto → dark → light, instead of Starlight's native <select>
// (its dropdown is drawn by the OS and ignores the site's style). Same storage key and values as
// Starlight, so its theme provider in <head> applies the choice before the first paint.
import { ui } from '../../lib/i18n';

const { lang } = ui(Astro.url);
const labels =
	lang === 'ru'
		? { auto: 'Тема: как в системе', dark: 'Тема: тёмная', light: 'Тема: светлая' }
		: { auto: 'Theme: system', dark: 'Theme: dark', light: 'Theme: light' };
---

<button type="button" class="rj-icon-btn rj-theme" data-mode="auto" data-labels={JSON.stringify(labels)} aria-label={labels.auto} title={labels.auto}>
	<svg class="i-auto" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17z" fill="currentColor" stroke="none"></path></svg>
	<svg class="i-dark" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
	<svg class="i-light" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path></svg>
</button>

<style>
	.rj-theme svg {
		display: none;
	}
	.rj-theme[data-mode='auto'] .i-auto,
	.rj-theme[data-mode='dark'] .i-dark,
	.rj-theme[data-mode='light'] .i-light {
		display: block;
	}
</style>

<script>
	const KEY = 'starlight-theme';
	const ORDER = ['auto', 'dark', 'light'] as const;
	type Mode = (typeof ORDER)[number];
	const light = matchMedia('(prefers-color-scheme: light)');
	const stored = (): Mode => {
		try {
			const v = localStorage.getItem(KEY);
			return v === 'dark' || v === 'light' ? v : 'auto';
		} catch {
			return 'auto';
		}
	};
	const apply = (mode: Mode) => {
		document.documentElement.dataset.theme = mode === 'auto' ? (light.matches ? 'light' : 'dark') : mode;
		for (const btn of document.querySelectorAll<HTMLButtonElement>('.rj-theme')) {
			const labels = JSON.parse(btn.dataset.labels ?? '{}');
			btn.dataset.mode = mode;
			btn.title = btn.ariaLabel = labels[mode];
		}
	};
	for (const btn of document.querySelectorAll<HTMLButtonElement>('.rj-theme')) {
		btn.addEventListener('click', () => {
			const current = (btn.dataset.mode as Mode | undefined) ?? stored();
			const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
			try {
				localStorage.setItem(KEY, next === 'auto' ? '' : next);
			} catch {
				/* Without storage the choice lasts until the next page. */
			}
			apply(next);
		});
	}
	light.addEventListener('change', () => stored() === 'auto' && apply('auto'));
	apply(stored());
</script>
