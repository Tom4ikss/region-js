---
// Header: logo, the "experiment" badge and primary links on the left; search, GitHub, theme and
// language on the right. The same header is used on the landing page and in the docs.
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LanguageSelect from './LanguageSelect.astro';
import { GITHUB, pageHref } from '../../lib/site.mjs';
import { ui } from '../../lib/i18n';

const { lang, t } = ui(Astro.url);
const path = Astro.url.pathname;
const numbers = pageHref(lang, 'numbers');
const links = [
	{ label: t.docs, href: pageHref(lang, 'problem'), current: path !== pageHref(lang, 'index') && !path.startsWith(numbers) },
	{ label: t.benchmarks, href: numbers, current: path.startsWith(numbers) },
];
---

<div class="rj-header">
	<div class="left">
		<SiteTitle />
		<span class="rj-badge">{t.badge}</span>
		<nav class="primary sl-hidden md:sl-flex" aria-label={lang === 'ru' ? 'Основные разделы' : 'Primary'}>
			{links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
		</nav>
	</div>
	<div class="right">
		<div class="search print:hidden"><Search /></div>
		<div class="icons print:hidden">
			<a class="icon-link" href={GITHUB} aria-label={t.github} title={t.github}>
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
			</a>
			<div class="theme sl-hidden md:sl-flex"><ThemeSelect /></div>
			<LanguageSelect />
		</div>
	</div>
</div>

<style>
	.rj-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
	}
	.left,
	.right {
		display: flex;
		align-items: center;
		min-width: 0;
	}
	.left {
		gap: 0.75rem;
	}
	.right {
		gap: 0.5rem;
	}
	.rj-badge {
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		background: var(--rj-sun-wash);
		color: var(--rj-sun-ink);
		font-size: 0.72rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.primary {
		gap: 0.25rem;
		margin-inline-start: 0.5rem;
	}
	.primary a {
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: 0.9rem;
		font-weight: 550;
		text-decoration: none;
		transition: background-color 0.15s, color 0.15s;
	}
	.primary a:hover {
		background: var(--rj-surface-2);
		color: var(--sl-color-white);
	}
	.primary a[aria-current='page'] {
		background: var(--rj-violet-wash);
		color: var(--rj-violet-ink);
	}
	.icons {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.icon-link {
		display: inline-grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 0.6rem;
		color: var(--sl-color-gray-2);
	}
	.icon-link:hover {
		background: var(--rj-surface-2);
		color: var(--sl-color-white);
	}
	@media (max-width: 72rem) {
		.rj-badge {
			display: none;
		}
	}
	@media (max-width: 40rem) {
		/* Phones: the logo alone, the title stays for screen readers. */
		.left :global(.site-title span) {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}
	}
	@media (max-width: 49.99rem) {
		/* Leave room for Starlight's menu button on pages with a sidebar. */
		:global(:root[data-has-sidebar]) .right {
			margin-inline-end: 2.75rem;
		}
		/* Pages without a sidebar (the landing page) have no menu: keep the theme switch visible. */
		:global(:root:not([data-has-sidebar])) .theme {
			display: flex;
		}
	}
</style>
