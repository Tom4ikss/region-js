---
// Site title with the logo drawn inline, so CSS can colour it: the violet R is the region, the
// inner lane is the object it owns. The lane's colour is one of three region accents, picked at
// random per page view by a script in <head> before the first paint (sun without JavaScript).
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<svg class="rj-logo" viewBox="0 0 16 16" width="32" height="32" aria-hidden="true">
		<path class="rj-logo-lane" d="M4 15L4 5A1 1 0 0 1 5 4L10 4A1 1 0 0 1 10 6L7.69 6A1 1 0 0 0 6.84 7.53L11.47 15L9.12 15L6 9.97L6 15Z"></path>
		<path class="rj-logo-region" d="M1 15L1 5A4 4 0 0 1 5 1L10 1A4 4 0 0 1 11.17 8.82L15 15L12.65 15L7.69 7L10 7A2 2 0 0 0 10 3L5 3A2 2 0 0 0 3 5L3 15Z"></path>
	</svg>
	<span translate="no">{siteTitle}</span>
</a>

<style>
	/* Starlight's own title styles, which an override does not inherit. */
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		span {
			overflow: hidden;
		}
	}
</style>
