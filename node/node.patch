diff --git a/lib/internal/regions.js b/lib/internal/regions.js
new file mode 100644
index 00000000..b44c3739
--- /dev/null
+++ b/lib/internal/regions.js
@@ -0,0 +1,170 @@
+'use strict';
+
+// Ownership regions (node --harmony-regions): a first cut of the Region class
+// of region-js. It covers creating a region, making it current for #{} and #[]
+// literals, finding the region of an object and moving a region to another
+// thread in the transfer list of postMessage(). Freezing and borrowing, spawn
+// and channels are not here yet.
+
+const {
+  SafeFinalizationRegistry,
+  SafeMap,
+  SafeWeakRef,
+  SymbolDispose,
+} = primordials;
+
+const binding = internalBinding('regions');
+const { validateFunction } = require('internal/validators');
+const {
+  kDeserialize,
+  kTransfer,
+  markTransferMode,
+} = require('internal/worker/js_transferable');
+
+// Region objects by id, so that Region.of() gives the same object every time.
+// Each one holds a handle on its region, which keeps the id valid.
+const handles = new SafeMap();
+const finalizer = new SafeFinalizationRegistry((id) => {
+  const ref = handles.get(id);
+  if (ref !== undefined && ref.deref() === undefined) handles.delete(id);
+  binding.removeHandle(id);
+});
+
+// What the constructor does instead of creating a region: kExisting for
+// Region.of(), which passes the id in existingId, and kReceiving for a region
+// that arrives in a message, which kDeserialize gets.
+const kCreate = 0;
+const kExisting = 1;
+const kReceiving = 2;
+let construct = kCreate;
+let existingId = -1;
+
+function ownershipError(id, message) {
+  // OwnershipError is a global of the engine with --harmony-regions.
+  const error = new globalThis.OwnershipError(message);
+  error.region = id;
+  return error;
+}
+
+function enter(id) {
+  if (!binding.enter(id)) {
+    throw ownershipError(id, 'Region is not owned by this thread');
+  }
+}
+
+function track(region, id) {
+  handles.set(id, new SafeWeakRef(region));
+  finalizer.register(region, id);
+}
+
+class Region {
+  #id = -1;
+
+  constructor() {
+    markTransferMode(this, false, true);
+    const how = construct;
+    construct = kCreate;
+    if (how === kReceiving) return;
+    let id;
+    if (how === kExisting) {
+      id = existingId;
+      binding.addHandle(id);
+    } else {
+      id = binding.create();
+      if (id < 0) throw new RangeError('Too many regions');
+    }
+    this.#id = id;
+    track(this, id);
+  }
+
+  get id() {
+    return this.#id;
+  }
+
+  get owned() {
+    return binding.isOwner(this.#id);
+  }
+
+  // Calls fn with the region current: the #{} and #[] literals of fn allocate
+  // in it.
+  run(fn) {
+    validateFunction(fn, 'fn');
+    const id = this.#id;
+    enter(id);
+    try {
+      return fn();
+    } finally {
+      binding.exit(id);
+    }
+  }
+
+  // Makes the region current until the returned scope is disposed, as in
+  // `using _ = region.enter()`.
+  enter() {
+    const id = this.#id;
+    enter(id);
+    let open = true;
+    const exit = () => {
+      if (!open) return;
+      open = false;
+      binding.exit(id);
+    };
+    return { __proto__: null, exit, [SymbolDispose]: exit };
+  }
+
+  // postMessage(value, [region]) moves the region: this thread gives it up
+  // and the receiving one owns it. Objects of the region in the message go by
+  // reference.
+  [kTransfer]() {
+    const id = this.#id;
+    const generation = binding.release(id);
+    if (generation < 0) {
+      throw ownershipError(id, binding.isOwner(id) ?
+        'Region cannot move: it is sealed or in an RwLock' :
+        'Region is not owned by this thread');
+    }
+    return {
+      data: { id, generation },
+      deserializeInfo: 'internal/regions:RegionReceiver',
+    };
+  }
+
+  [kDeserialize]({ id, generation }) {
+    if (!binding.claim(id, generation)) {
+      throw ownershipError(id, 'Region is not in transit');
+    }
+    this.#id = id;
+    track(this, id);
+  }
+
+  // The region of a region object.
+  static of(value) {
+    const id = binding.regionOf(value);
+    if (id < 0) {
+      throw new TypeError('Region.of() expects an object from a region');
+    }
+    const existing = handles.get(id)?.deref();
+    if (existing !== undefined) return existing;
+    construct = kExisting;
+    existingId = id;
+    return new Region();
+  }
+
+  static isRegionObject(value) {
+    return binding.regionOf(value) >= 0;
+  }
+}
+
+// The receiving end of postMessage(): a Region without a region yet, which
+// kDeserialize gives the moved one.
+function RegionReceiver() {
+  construct = kReceiving;
+  return new Region();
+}
+RegionReceiver.prototype = Region.prototype;
+
+module.exports = {
+  enabled: binding.enabled,
+  Region,
+  RegionReceiver,
+};
