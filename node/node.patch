diff --git a/lib/internal/regions.js b/lib/internal/regions.js
new file mode 100644
index 00000000..c30072d8
--- /dev/null
+++ b/lib/internal/regions.js
@@ -0,0 +1,40 @@
+'use strict';
+
+// Ownership regions (node --harmony-regions): the globals of V8's region
+// runtime, the same as in d8: Region, Channel, RwLock, LocalRef, spawn() and
+// JoinSet. Regions move between threads in the transfer list of
+// postMessage(), and spawn() runs its tasks in worker_threads workers.
+
+const {
+  ObjectGetOwnPropertyNames,
+} = primordials;
+
+const binding = internalBinding('regions');
+
+let exportPort;
+
+// Starts a pool worker of spawn(). The worker gets the task port by number;
+// its message listener keeps it running, as a pool worker must. The pool
+// does not keep the process alive: a thread that waits for the reply of a
+// task does.
+function startWorker(source, port) {
+  const { Worker } = require('worker_threads');
+  const id = exportPort(port);
+  const worker = new Worker(`${source}
+require('worker_threads').parentPort.on('message', () => {});
+__start(Region.__importPort(${id}));`, { eval: true });
+  worker.unref();
+  return worker;
+}
+
+function setup() {
+  binding.installGlobals();
+  exportPort = globalThis.Region.__exportPort;
+  // Before user code: these are the globals every thread has, which spawn()
+  // callbacks use without capturing them.
+  binding.installSpawn(startWorker, ObjectGetOwnPropertyNames(globalThis));
+}
+
+module.exports = {
+  setup,
+};
