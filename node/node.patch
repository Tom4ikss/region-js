diff --git a/src/node_regions.cc b/src/node_regions.cc
new file mode 100644
index 00000000..508cfd5d
--- /dev/null
+++ b/src/node_regions.cc
@@ -0,0 +1,151 @@
+// Ownership regions (node --harmony-regions): the globals of V8's region
+// runtime, as d8 has them, on every thread. Regions need a shared heap, so
+// they exist only in builds with a shared pointer compression cage.
+
+#include <string>
+#include <vector>
+
+#include "env-inl.h"
+#include "node_binding.h"
+#include "node_external_reference.h"
+#include "util-inl.h"
+#include "uv.h"
+#include "v8-regions.h"
+
+namespace node {
+namespace regions {
+
+using v8::Array;
+using v8::Boolean;
+using v8::Context;
+using v8::Function;
+using v8::FunctionCallbackInfo;
+using v8::Isolate;
+using v8::Local;
+using v8::MaybeLocal;
+using v8::Object;
+using v8::String;
+using v8::Undefined;
+using v8::Value;
+using v8::experimental::Regions;
+
+// installGlobals(): Region, Channel, RwLock and LocalRef.
+static void InstallGlobals(const FunctionCallbackInfo<Value>& args) {
+  Local<Context> context = args.GetIsolate()->GetCurrentContext();
+  USE(Regions::InstallGlobals(context));
+}
+
+// The names of the globals that every thread has, for the probe context of
+// spawn(): callbacks use those without capturing them. One isolate per
+// thread.
+thread_local std::vector<std::string> global_names;
+
+static MaybeLocal<Context> NewProbeContext(Isolate* isolate) {
+  Local<Context> context = Context::New(isolate);
+  Context::Scope context_scope(context);
+  for (const std::string& name : global_names) {
+    Local<String> key;
+    if (!String::NewFromUtf8(isolate, name.c_str()).ToLocal(&key) ||
+        context->Global()->Set(context, key, Undefined(isolate)).IsNothing()) {
+      return {};
+    }
+  }
+  return context;
+}
+
+// Keeps the event loop running while the thread waits for another one: for
+// a channel or lock operation, or for the reply of a spawn() task. The reply
+// comes as a platform task, which wakes the loop. The check handle is
+// referenced from when the runtime says that a wait may have started until
+// a turn of the loop finds none.
+class KeepAlive {
+ public:
+  explicit KeepAlive(Environment* env) : env_(env) {
+    CHECK_EQ(uv_check_init(env->event_loop(), &check_), 0);
+    CHECK_EQ(uv_check_start(&check_, OnCheck), 0);
+    uv_unref(reinterpret_cast<uv_handle_t*>(&check_));
+    Regions::SetPendingWorkCallback(env->isolate(), OnPendingWork, this);
+    env->AddCleanupHook(Close, this);
+  }
+
+ private:
+  static void OnPendingWork(Isolate* isolate, void* data) {
+    KeepAlive* keep_alive = static_cast<KeepAlive*>(data);
+    if (keep_alive->referenced_) return;
+    keep_alive->referenced_ = true;
+    uv_ref(reinterpret_cast<uv_handle_t*>(&keep_alive->check_));
+  }
+
+  static void OnCheck(uv_check_t* handle) {
+    KeepAlive* keep_alive = ContainerOf(&KeepAlive::check_, handle);
+    if (!keep_alive->referenced_ ||
+        Regions::HasPendingWork(keep_alive->env_->isolate())) {
+      return;
+    }
+    keep_alive->referenced_ = false;
+    uv_unref(reinterpret_cast<uv_handle_t*>(handle));
+  }
+
+  static void Close(void* data) {
+    KeepAlive* keep_alive = static_cast<KeepAlive*>(data);
+    Regions::SetPendingWorkCallback(
+        keep_alive->env_->isolate(), nullptr, nullptr);
+    uv_close(reinterpret_cast<uv_handle_t*>(&keep_alive->check_),
+             [](uv_handle_t* handle) {
+               KeepAlive* closed = ContainerOf(
+                   &KeepAlive::check_, reinterpret_cast<uv_check_t*>(handle));
+               delete closed;
+             });
+  }
+
+  Environment* env_;
+  uv_check_t check_;
+  bool referenced_ = false;
+};
+
+// installSpawn(startWorker, globalNames): spawn(), spawn.scope() and JoinSet.
+// startWorker(source, port) starts a pool worker; globalNames are the
+// globals that every thread has.
+static void InstallSpawn(const FunctionCallbackInfo<Value>& args) {
+  Environment* env = Environment::GetCurrent(args);
+  Isolate* isolate = args.GetIsolate();
+  Local<Context> context = isolate->GetCurrentContext();
+  CHECK(args[0]->IsFunction());
+  CHECK(args[1]->IsArray());
+  Local<Array> names = args[1].As<Array>();
+  global_names.clear();
+  for (uint32_t i = 0; i < names->Length(); i++) {
+    Local<Value> name;
+    if (!names->Get(context, i).ToLocal(&name)) return;
+    if (!name->IsString()) continue;
+    global_names.emplace_back(*Utf8Value(isolate, name));
+  }
+  new KeepAlive(env);
+  Regions::InstallSpawn(context, args[0].As<Function>(), NewProbeContext);
+}
+
+static void Initialize(Local<Object> target,
+                       Local<Value> unused,
+                       Local<Context> context,
+                       void* priv) {
+  Isolate* isolate = Isolate::GetCurrent();
+  target
+      ->Set(context,
+            FIXED_ONE_BYTE_STRING(isolate, "enabled"),
+            Boolean::New(isolate, Regions::IsEnabled(isolate)))
+      .Check();
+  SetMethod(context, target, "installGlobals", InstallGlobals);
+  SetMethod(context, target, "installSpawn", InstallSpawn);
+}
+
+static void RegisterExternalReferences(ExternalReferenceRegistry* registry) {
+  registry->Register(InstallGlobals);
+  registry->Register(InstallSpawn);
+}
+
+}  // namespace regions
+}  // namespace node
+
+NODE_BINDING_CONTEXT_AWARE_INTERNAL(regions, node::regions::Initialize)
+NODE_BINDING_EXTERNAL_REFERENCE(regions,
+                                node::regions::RegisterExternalReferences)
