diff --git a/src/node_regions.cc b/src/node_regions.cc
new file mode 100644
index 00000000..d504a583
--- /dev/null
+++ b/src/node_regions.cc
@@ -0,0 +1,115 @@
+// Ownership regions (node --harmony-regions): the binding behind the Region
+// global of lib/internal/regions.js, on top of V8's experimental
+// v8-regions.h. Regions need a shared heap, so they exist only in builds with
+// a shared pointer compression cage.
+
+#include "env-inl.h"
+#include "node_binding.h"
+#include "node_external_reference.h"
+#include "util-inl.h"
+#include "v8-regions.h"
+
+namespace node {
+namespace regions {
+
+using v8::Boolean;
+using v8::Context;
+using v8::FunctionCallbackInfo;
+using v8::Int32;
+using v8::Isolate;
+using v8::Local;
+using v8::Object;
+using v8::Value;
+using v8::experimental::Regions;
+
+// create(): a new region owned by this thread with one handle on it, or -1.
+static void Create(const FunctionCallbackInfo<Value>& args) {
+  args.GetReturnValue().Set(Regions::Create(args.GetIsolate()));
+}
+
+static int RegionArg(const FunctionCallbackInfo<Value>& args) {
+  CHECK(args[0]->IsInt32());
+  return args[0].As<Int32>()->Value();
+}
+
+static void AddHandle(const FunctionCallbackInfo<Value>& args) {
+  Regions::AddHandle(RegionArg(args));
+}
+
+static void RemoveHandle(const FunctionCallbackInfo<Value>& args) {
+  Regions::RemoveHandle(RegionArg(args));
+}
+
+static void IsOwner(const FunctionCallbackInfo<Value>& args) {
+  args.GetReturnValue().Set(
+      Regions::IsOwner(args.GetIsolate(), RegionArg(args)));
+}
+
+// enter(id): makes the region current; false when this thread does not own
+// it.
+static void Enter(const FunctionCallbackInfo<Value>& args) {
+  args.GetReturnValue().Set(Regions::Enter(args.GetIsolate(), RegionArg(args)));
+}
+
+static void Exit(const FunctionCallbackInfo<Value>& args) {
+  Regions::Exit(args.GetIsolate(), RegionArg(args));
+}
+
+// release(id): gives the region up for a move to another thread; the
+// generation to claim it with, or -1.
+static void Release(const FunctionCallbackInfo<Value>& args) {
+  args.GetReturnValue().Set(
+      Regions::Release(args.GetIsolate(), RegionArg(args)));
+}
+
+// claim(id, generation): takes a region that another thread gave up.
+static void Claim(const FunctionCallbackInfo<Value>& args) {
+  CHECK(args[1]->IsInt32());
+  args.GetReturnValue().Set(Regions::Claim(
+      args.GetIsolate(), RegionArg(args), args[1].As<Int32>()->Value()));
+}
+
+// regionOf(value): the region of a region object, -1 for anything else.
+static void RegionOf(const FunctionCallbackInfo<Value>& args) {
+  args.GetReturnValue().Set(Regions::RegionOf(args[0]));
+}
+
+static void Initialize(Local<Object> target,
+                       Local<Value> unused,
+                       Local<Context> context,
+                       void* priv) {
+  Isolate* isolate = Isolate::GetCurrent();
+  target
+      ->Set(context,
+            FIXED_ONE_BYTE_STRING(isolate, "enabled"),
+            Boolean::New(isolate, Regions::IsEnabled(isolate)))
+      .Check();
+  SetMethod(context, target, "create", Create);
+  SetMethod(context, target, "addHandle", AddHandle);
+  SetMethod(context, target, "removeHandle", RemoveHandle);
+  SetMethodNoSideEffect(context, target, "isOwner", IsOwner);
+  SetMethod(context, target, "enter", Enter);
+  SetMethod(context, target, "exit", Exit);
+  SetMethod(context, target, "release", Release);
+  SetMethod(context, target, "claim", Claim);
+  SetMethodNoSideEffect(context, target, "regionOf", RegionOf);
+}
+
+static void RegisterExternalReferences(ExternalReferenceRegistry* registry) {
+  registry->Register(Create);
+  registry->Register(AddHandle);
+  registry->Register(RemoveHandle);
+  registry->Register(IsOwner);
+  registry->Register(Enter);
+  registry->Register(Exit);
+  registry->Register(Release);
+  registry->Register(Claim);
+  registry->Register(RegionOf);
+}
+
+}  // namespace regions
+}  // namespace node
+
+NODE_BINDING_CONTEXT_AWARE_INTERNAL(regions, node::regions::Initialize)
+NODE_BINDING_EXTERNAL_REFERENCE(regions,
+                                node::regions::RegisterExternalReferences)
