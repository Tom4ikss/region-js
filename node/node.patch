+// Runs a blocking libuv call with the isolate parked: a garbage collection
+// of the shared heap, which stops every isolate that uses it, does not wait
+// for this thread meanwhile. The call must not touch the V8 heap.
+template <typename Call>
+int CallWhileParked(v8::Isolate* isolate, Call call) {
+  // Only shared heap GCs wait for other threads.
+  if (!v8::experimental::Regions::IsEnabled(isolate)) return call();
+  struct Data {
+    Call* call;
+    int result;
+  } data = {&call, 0};
+  isolate->ExecuteWhileParked(
+      [](void* raw) {
+        Data* data = static_cast<Data*>(raw);
+        data->result = (*data->call)();
+      },
+      &data);
+  return data.result;
+}
